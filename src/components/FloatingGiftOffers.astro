---
// Floating gift button + offers panel. All numbers come from settings (bundles, shipping),
// all texts from settings.offersDrawer — nothing is hard-coded here.
import { SETTINGS, BUNDLES } from '../data/catalog';
interface Props { side?: 'right' | 'left' }
const { side = 'right' } = Astro.props;
const cfg = SETTINGS.offersDrawer;
const fee = SETTINGS.shippingFee;
const rec = SETTINGS.recommendedBundle;
const two = BUNDLES.find((b) => b.size === 2), three = BUNDLES.find((b) => b.size === 3);
// "third poster for X more": only when the 3-poster bundle ships free and the 2-poster one does not
const upgrade = two && three && three.freeShipping && !two.freeShipping ? three.price - (two.price + fee) : null;
const offers = [...BUNDLES].sort((a, b) => a.size - b.size).map((b) => ({
  size: b.size,
  price: b.price,
  terms: b.freeShipping ? (b.gift ? 'უფასო მიწოდება + საჩუქარი' : 'უფასო მიწოდება') : `მიწოდება — ${fee} ₾`,
  total: b.price + (b.freeShipping ? 0 : fee),
  recommended: b.size === rec,
}));
---
{cfg?.active && (
  <div class={`fgo fgo-${side}`} id="fgo">
    <button type="button" class="fgo-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="fgo-panel">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3.5" y="9" width="17" height="11.5" rx="1.5" /><path d="M2.5 9h19v3.2h-19zM12 9v11.5" />
        <path d="M12 9c-1.6-.1-4.4-.6-4.9-2.6C6.7 4.8 8.6 4 9.8 5c1 .8 1.8 2.6 2.2 4zM12 9c1.6-.1 4.4-.6 4.9-2.6.4-1.6-1.5-2.4-2.7-1.4-1 .8-1.8 2.6-2.2 4z" />
      </svg>
      <span class="fgo-label">შეთავაზებები</span>
    </button>
    <div class="fgo-backdrop" hidden></div>
    <div class="fgo-panel" id="fgo-panel" role="dialog" aria-modal="true" aria-labelledby="fgo-h" hidden>
      <button type="button" class="fgo-x" aria-label="დახურვა">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
      <span class="fgo-grab" aria-hidden="true"></span>
      <h2 id="fgo-h">{cfg.heading}</h2>
      <p class="fgo-txt">{cfg.text}</p>
      <ul class="fgo-list">
        {offers.map((o) => (
          <li class:list={['fgo-offer', { rec: o.recommended }]}>
            {o.recommended && <span class="fgo-badge">რეკომენდებული</span>}
            <div class="fgo-row"><b>{o.size} პოსტერი</b><b class="fgo-price">{o.price} ₾</b></div>
            <div class="fgo-row muted"><span>{o.terms}</span><span>სულ {o.total} ₾</span></div>
          </li>
        ))}
      </ul>
      {upgrade !== null && upgrade > 0 && <p class="fgo-up">მესამე პოსტერი სულ რაღაც {upgrade} ₾-ით მეტი ჯდება და მიწოდებაც უფასოა.</p>}
      <a href={cfg.ctaHref} class="btn fgo-cta">{cfg.cta}</a>
    </div>
  </div>
)}
<style>
  .fgo-btn { position: fixed; z-index: 55; top: 50%; display: flex; align-items: center; gap: 8px; padding: 14px 12px; border: 0; background: var(--forest); color: var(--gold-tint); box-shadow: var(--shadow); transition: background .18s ease, padding .18s ease, transform .3s var(--ease), opacity .2s ease; }
  .fgo-right .fgo-btn { right: 0; border-radius: 14px 0 0 14px; transform: translateY(-50%); }
  .fgo-left .fgo-btn { left: 0; border-radius: 0 14px 14px 0; transform: translateY(-50%); }
  .fgo-btn:hover { background: var(--forest-hover); }
  .fgo-label { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 13px; font-weight: 600; letter-spacing: .02em; color: #fff; }
  .fgo-btn { flex-direction: column; }
  /* hidden while a bundle is being built (its own bar is at the bottom) */
  :global(body.bb-on) .fgo-btn { opacity: 0; pointer-events: none; }

  .fgo-backdrop { position: fixed; inset: 0; z-index: 70; background: rgba(37, 42, 39, .32); opacity: 0; transition: opacity .25s ease; }
  .fgo-panel { position: fixed; z-index: 71; top: 16px; max-height: calc(100% - 32px); width: min(400px, calc(100% - 32px)); overflow-y: auto; padding: 28px 24px 24px; background: var(--surface); border-radius: var(--r-lg); box-shadow: var(--shadow-lg); transition: transform .3s var(--ease); }
  .fgo-right .fgo-panel { right: 16px; transform: translateX(calc(100% + 24px)); }
  .fgo-left .fgo-panel { left: 16px; transform: translateX(calc(-100% - 24px)); }
  .fgo.open .fgo-panel { transform: none; }
  .fgo.open .fgo-backdrop { opacity: 1; }
  .fgo-x { position: absolute; top: 14px; right: 14px; display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 10px; background: var(--surface-2); color: var(--text); }
  .fgo-x:hover { background: var(--forest-tint); color: var(--forest); }
  .fgo-grab { display: none; }
  .fgo-panel h2 { font-size: 26px; margin: 4px 48px 8px 0; }
  .fgo-txt { margin: 0 0 20px; color: var(--muted); }
  .fgo-list { list-style: none; margin: 0 0 20px; padding: 0; display: grid; gap: 10px; }
  .fgo-offer { position: relative; padding: 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--surface); }
  .fgo-offer.rec { border: 1.5px solid var(--forest); background: var(--forest-tint); }
  .fgo-badge { position: absolute; top: -10px; left: 14px; padding: 2px 10px; border-radius: 999px; background: var(--forest); color: #fff; font-size: 12px; font-weight: 600; }
  .fgo-row { display: flex; justify-content: space-between; gap: 12px; }
  .fgo-row b { font: 600 18px var(--display); }
  .fgo-row.muted { margin-top: 4px; font-size: 14px; }
  .fgo-cta { width: 100%; }
  .fgo-up { margin: -6px 0 18px; padding: 10px 14px; border-radius: var(--r-sm); background: var(--gold-tint); color: #5E4A28; font-size: 14px; }

  @media (max-width: 760px) {
    .fgo-right .fgo-btn, .fgo-left .fgo-btn { top: auto; bottom: calc(16px + env(safe-area-inset-bottom)); transform: none; width: 54px; height: 54px; padding: 0; justify-content: center; border-radius: 50%; }
    .fgo-right .fgo-btn { right: 16px; } .fgo-left .fgo-btn { left: 16px; }
    .fgo-label { display: none; }
    .fgo-panel, .fgo-right .fgo-panel, .fgo-left .fgo-panel { top: auto; left: 0; right: 0; bottom: 0; width: 100%; max-height: 88vh; padding: 14px 20px calc(20px + env(safe-area-inset-bottom)); border-radius: var(--r-lg) var(--r-lg) 0 0; transform: translateY(100%); }
    .fgo-grab { display: block; width: 40px; height: 4px; margin: 0 auto 14px; border-radius: 2px; background: var(--border); }
    .fgo-x { top: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .fgo-panel, .fgo-backdrop { transition: none; } }
</style>
<script>
  import { pushLayer, popLayer } from '../lib/backstack';
  const root = document.getElementById('fgo');
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>('.fgo-btn')!, panel = root.querySelector<HTMLElement>('.fgo-panel')!;
    const back = root.querySelector<HTMLElement>('.fgo-backdrop')!;
    let last: HTMLElement | null = null;
    const focusables = () => [...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
    function open() {
      last = document.activeElement as HTMLElement;
      panel.hidden = back.hidden = false;
      requestAnimationFrame(() => root!.classList.add('open'));
      btn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      pushLayer('offers', () => close(true));
      setTimeout(() => focusables()[0]?.focus(), 50);
    }
    function close(fromBack = false, href?: string) {
      if (panel.hidden) return;
      if (!fromBack) popLayer('offers', href);
      root!.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      const done = () => { panel.hidden = back.hidden = true; };
      matchMedia('(prefers-reduced-motion: reduce)').matches ? done() : setTimeout(done, 300);
      (last ?? btn).focus();
    }
    btn.addEventListener('click', open);
    back.addEventListener('click', () => close());
    root.querySelector('.fgo-x')!.addEventListener('click', () => close());
    panel.querySelector<HTMLAnchorElement>('.fgo-cta')?.addEventListener('click', (e) => { e.preventDefault(); close(false, (e.currentTarget as HTMLAnchorElement).href); });
    document.addEventListener('keydown', (e) => {
      if (panel.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      if (e.key === 'Tab') { // keep focus inside the panel
        const f = focusables(); if (!f.length) return;
        const first = f[0], lastEl = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); lastEl.focus(); }
        else if (!e.shiftKey && document.activeElement === lastEl) { e.preventDefault(); first.focus(); }
      }
    });
  }
</script>
