---
import { PRODUCTS, productBySlug } from '../data/catalog';
// დემოსთვის გვჭირდება პოსტერი ორი ფოტოთი: გადაუფხეკელი და გადაფხეკილი
const demo = [productBySlug('top-100-movies'), ...PRODUCTS].find((p) => p && p.images.length > 1);
// დაფარული უჯრების ზუსტი კოორდინატები (ფოტოს წილებში) — გადაფხეკა მხოლოდ აქ ხდება, სათაური და ჩარჩო ხელუხლებელია.
// ამოღებულია „ტოპ 100 ფილმი“-ს დაფარული/გადაფხეკილი ფოტოების შედარებით (10 × 10 ბადე).
const GRIDS: Record<string, { cols: number[][]; rows: number[][]; ratio: number }> = {
  'top-100-movies': {
    ratio: 1600 / 2251,
    cols: [[.0519, .1306], [.1431, .2206], [.2331, .3119], [.3244, .4031], [.4156, .4931], [.5056, .5844], [.5969, .6756], [.6881, .7656], [.7781, .8569], [.8694, .9475]],
    rows: [[.1031, .159], [.1844, .2403], [.2661, .3212], [.3478, .4029], [.4287, .4847], [.5104, .5655], [.5917, .6473], [.6739, .729], [.7548, .8108], [.8361, .892]],
  },
};
const grid = demo ? GRIDS[demo.slug] : undefined;
const steps = [
  { n: '1', t: 'აირჩიე', d: 'თემა, რომელიც შენ ან შენს ახლობელს უყვარს: ფილმები, მოგზაურობა, წიგნები, წყვილის იდეები.' },
  { n: '2', t: 'გადაფხიკე', d: 'უყურე, წაიკითხე, ეწვიე ან შეასრულე, და მონეტით გადაფხიკე შესაბამისი უჯრა.' },
  { n: '3', t: 'შექმენი შენი ისტორია', d: 'ყოველი გახსნილი უჯრა ერთი მოგონებაა. პოსტერი თანდათან შენს ისტორიად იქცევა.' },
];
// line icons (24×24, stroke)
const I = {
  wall: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/>',
  leaf: '<path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="M5 19 13 11"/>',
  gift: '<rect x="3" y="9" width="18" height="12" rx="1.5"/><path d="M3 13h18M12 9v12M12 9c-2-4-6-4-6-1.5S9 9 12 9Zm0 0c2-4 6-4 6-1.5S15 9 12 9Z"/>',
};
const perks = [
  { i: I.wall, t: 'შენი ისტორია კედელზე', d: 'ყოველი გადაფხეკილი უჯრა ერთი ნანახი ფილმი, წაკითხული წიგნი ან გავლილი გზაა.' },
  { i: I.spark, t: 'მიზეზი ახალი რამისთვის', d: '„დღეს რას ვუყუროთ?“ ან „სად წავიდეთ?“ — პასუხი უკვე კედელზე გელოდება.' },
  { i: I.leaf, t: 'ლამაზია ყოველ ეტაპზე', d: 'დაფარულიც, ნახევრად გადაფხეკილიც და ბოლომდე შევსებულიც.' },
  { i: I.gift, t: 'საჩუქარი, რომელიც ახსოვთ', d: 'კინომოყვარულს, მკითხველს, მოგზაურს თუ წყვილს — თვეობით გამოსაყენებელი.' },
];
---
<section id="how-it-works" class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">როგორ მუშაობს</span>
        <h2>ერთი პოსტერი. უამრავი ახალი იდეა.</h2>
      </div>
      <p>ყველა უჯრა ვერცხლისფერი ფენითაა დაფარული. რასაც გამოცდი, იმას გადაფხეკ — და პოსტერი შენთან ერთად ივსება.</p>
    </div>

    <div class="how">
      <div class="demo">
        <div class="box" style={`aspect-ratio:${grid ? grid.ratio : 3 / 4}`}>
          {demo ? <img class="under" src={demo.images[1].thumb} alt={`${demo.title} — გადაფხეკილი`} loading="lazy" decoding="async" /> : <div class="under txt"><b>ნანახია!</b></div>}
          <canvas data-cover={demo?.images[0].thumb} data-grid={grid ? JSON.stringify({ c: grid.cols, r: grid.rows }) : undefined} aria-label="გადაფხიკე აქ — სცადე თითით ან მაუსით"></canvas>
          <span class="coin" aria-hidden="true"></span>
        </div>
        <div class="dm-row"><span class="hint" id="sc-p">გადაუსვი მონეტა უჯრებს</span><span class="dm-b"><button type="button" class="btn sm ghost" id="sc-all">სრულად გახსნა</button><button type="button" class="btn sm ghost" id="sc-r">თავიდან</button></span></div>
      </div>

      <ol class="steps">
        {steps.map((s) => (
          <li class="step rv">
            <span class="n">{s.n}</span>
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </li>
        ))}
      </ol>
    </div>

    <div class="perks">
      {perks.map((p, i) => (
        <article class="perk rv" style={`--d:${i * 70}ms`}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={p.i} />
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>

    <div class="cta">
      <a href="#catalog" class="btn">ნახე პოსტერები</a>
      <a href="#bundle-builder" class="btn ghost">ააწყვე ნაკრები</a>
    </div>
  </div>
</section>
<style>
  .how { display: grid; grid-template-columns: minmax(0, 360px) 1fr; gap: clamp(28px, 6vw, 80px); align-items: center; }
  .demo { width: 100%; max-width: 360px; margin: 0 auto; }
  .box { position: relative; background: var(--surface); border-radius: var(--r-sm, 12px); box-shadow: var(--shadow); overflow: hidden; }
  .under, canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  img.under { object-fit: cover; }
  .under.txt { display: flex; align-items: center; justify-content: center; }
  canvas { touch-action: none; cursor: none; }
  /* მონეტა კურსორის ადგილას (ჩნდება, როცა მაუსი/თითი პოსტერზეა) */
  .coin { position: absolute; left: 0; top: 0; z-index: 2; width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; pointer-events: none; opacity: 0; transition: opacity .2s ease;
    background: radial-gradient(circle at 34% 30%, #FFF6D8, #E2C27C 45%, #B8924A 70%, #8F6E33); box-shadow: 0 3px 8px rgba(60, 45, 15, .35), inset 0 0 0 2px rgba(255, 246, 216, .45); }
  .coin::after { content: ''; position: absolute; inset: 6px; border-radius: 50%; border: 1px solid rgba(143, 110, 51, .45); }
  .coin.on { opacity: 1; }
  .dm-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .hint { font-size: 14px; color: var(--muted); }
  .dm-b { display: flex; gap: 6px; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; counter-reset: s; }
  .step { display: flex; align-items: flex-start; gap: 18px; padding: 22px 0; border-bottom: 1px solid var(--border); }
  .step:first-child { padding-top: 0; }
  .step:last-child { border-bottom: 0; }
  .n { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--forest-tint); color: var(--forest); font: 600 18px var(--display); }
  .step h3 { margin: 6px 0 6px; font-size: 22px; }
  .step p { margin: 0; color: var(--muted); max-width: 46ch; }

  .perks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: clamp(40px, 6vw, 64px); }
  .perk { padding: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md, 18px); }
  .ic { width: 28px; height: 28px; fill: none; stroke: var(--forest); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .perk h3 { margin: 14px 0 6px; font-size: 17px; }
  .perk p { margin: 0; font-size: 14.5px; color: var(--muted); }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }

  .js-rv .rv { opacity: 0; translate: 0 14px; transition: opacity .5s ease var(--d, 0ms), translate .5s var(--ease) var(--d, 0ms); }
  .js-rv .rv.in { opacity: 1; translate: 0 0; }
  @media (max-width: 980px) { .perks { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .how { grid-template-columns: 1fr; } .demo { max-width: 270px; }
    .step { padding: 16px 0; gap: 14px; } .n { width: 38px; height: 38px; font-size: 16px; } .step h3 { font-size: 19px; margin-top: 4px; }
    .perks { gap: 10px; } .perk { padding: 16px; } .perk h3 { font-size: 15.5px; } .perk p { font-size: 13.5px; }
    .cta .btn { flex: 1; padding: 0 8px; white-space: nowrap; }
  }
  @media (max-width: 380px) { .perks { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .js-rv .rv { opacity: 1; translate: none; transition: none; } }
</style>
<script>
  // გამოჩენის ანიმაცია
  const rv = document.querySelectorAll('#how-it-works .rv');
  if ('IntersectionObserver' in window) {
    document.getElementById('how-it-works')!.classList.add('js-rv');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .15 });
    rv.forEach((el) => io.observe(el));
  } else rv.forEach((el) => el.classList.add('in'));

  // გადაფხეკის დემო: ქვემოთ გადაფხეკილი პოსტერია, ზემოდან — დაფარული.
  // მონეტა მიჰყვება კურსორს/თითს და ფხეკს მხოლოდ იმ უჯრას, რომელზეც დგას (სათაური, წარწერები და ჩარჩო ხელუხლებელია).
  // უჯრის დიდი ნაწილის გადაფხეკისას უჯრა ბოლომდე იხსნება.
  const cv = document.querySelector<HTMLCanvasElement>('#how-it-works canvas');
  if (cv) {
    const ctx = cv.getContext('2d')!;
    const label = document.getElementById('sc-p')!;
    const coin = cv.parentElement!.querySelector<HTMLElement>('.coin')!;
    const g = cv.dataset.grid ? (JSON.parse(cv.dataset.grid) as { c: number[][]; r: number[][] }) : null;
    // უჯრები [x0,y0,x1,y1] წილებში; ბადის გარეშე — მთელი ფართობი ერთი „უჯრაა“
    const CELLS = g ? g.r.flatMap(([y0, y1]) => g.c.map(([x0, x1]) => [x0, y0, x1, y1])) : [[0, 0, 1, 1]];
    const N = 4; // უჯრის შიგნით 4 × 4 საკონტროლო წერტილი
    let hits: Set<number>[] = [], done = new Set<number>(), W = 0, H = 0, cover: HTMLImageElement | null = null, last: { x: number; y: number } | null = null;
    const msg = () => { label.textContent = !g ? 'გადაფხიკე თითით ან მაუსით' : done.size === 0 ? 'გადაუსვი მონეტა უჯრებს' : done.size >= CELLS.length ? 'ასე ივსება შენი პოსტერი' : `${done.size} / ${CELLS.length} უჯრა გადაფხეკილია`; };
    const paint = () => {
      const r = cv.getBoundingClientRect(); if (!r.width) return;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = cv.width = Math.round(r.width * dpr); H = cv.height = Math.round(r.height * dpr);
      ctx.globalCompositeOperation = 'source-over';
      if (cover) ctx.drawImage(cover, 0, 0, W, H);
      else { ctx.fillStyle = '#d6d3ca'; ctx.fillRect(0, 0, W, H); }
      hits = CELLS.map(() => new Set()); done = new Set(); msg();
    };
    const src = cv.dataset.cover;
    if (src) { const im = new Image(); im.onload = () => { cover = im; paint(); }; im.src = src; }
    paint();
    if ('ResizeObserver' in window) { let w0 = 0; new ResizeObserver(() => { const w = cv.clientWidth; if (w && Math.abs(w - w0) > 2) { w0 = w; paint(); } }).observe(cv); }
    const rectPx = (c: number[]) => [c[0] * W + 1, c[1] * H + 1, (c[2] - c[0]) * W - 2, (c[3] - c[1]) * H - 2];
    const clearCell = (i: number) => { const [x, y, w, h] = rectPx(CELLS[i]); ctx.clearRect(x, y, w, h); done.add(i); };
    const cellAt = (x: number, y: number) => CELLS.findIndex((c) => x >= c[0] && x <= c[2] && y >= c[1] && y <= c[3]);
    // ერთი „მოსმა“ წერტილიდან წერტილამდე: იშლება მხოლოდ უჯრის შიგნით (clip)
    const stroke = (x: number, y: number) => {
      const i = cellAt(x, y);
      if (i >= 0 && !done.has(i)) {
        const c = CELLS[i], [rx, ry, rw, rh] = rectPx(c), rad = Math.max(rw, rh) * .34;
        ctx.save(); ctx.beginPath(); ctx.rect(rx, ry, rw, rh); ctx.clip();
        ctx.globalCompositeOperation = 'destination-out'; ctx.lineCap = 'round'; ctx.lineWidth = rad * 2;
        ctx.beginPath();
        if (last && cellAt(last.x, last.y) === i) { ctx.moveTo(last.x * W, last.y * H); ctx.lineTo(x * W, y * H); ctx.stroke(); }
        else { ctx.arc(x * W, y * H, rad, 0, Math.PI * 2); ctx.fill(); }
        ctx.restore();
        // რომელი საკონტროლო წერტილები მოხვდა მონეტის ქვეშ
        const h = hits[i], cw = c[2] - c[0], ch = c[3] - c[1], rr = rad * 1.05;
        for (let a = 0; a < N; a++) for (let b = 0; b < N; b++) {
          const px = c[0] + cw * (a + .5) / N, py = c[1] + ch * (b + .5) / N;
          if (Math.hypot((px - x) * W, (py - y) * H) <= rr) h.add(a * N + b);
        }
        if (h.size >= N * N * .55) clearCell(i);
        msg();
      }
      last = { x, y };
    };
    const pos = (e: PointerEvent) => { const r = cv.getBoundingClientRect(); return { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height, px: e.clientX - r.left, py: e.clientY - r.top }; };
    let down = false;
    const move = (e: PointerEvent) => {
      const p = pos(e);
      coin.style.transform = `translate(${p.px}px, ${p.py}px) rotate(${(p.px + p.py) % 40 - 20}deg)`;
      coin.classList.add('on');
      // მაუსით: საკმარისია მიტანა. თითით: გადაფხეკა თითის მოსმით.
      if (e.pointerType === 'mouse' || down) stroke(p.x, p.y); else last = null;
    };
    cv.addEventListener('pointerenter', (e) => { last = null; move(e); });
    cv.addEventListener('pointermove', move);
    cv.addEventListener('pointerdown', (e) => { down = true; cv.setPointerCapture(e.pointerId); last = null; move(e); });
    const up = () => { down = false; last = null; };
    cv.addEventListener('pointerup', up);
    cv.addEventListener('pointercancel', up);
    cv.addEventListener('pointerleave', () => { if (!down) { coin.classList.remove('on'); last = null; } });
    document.getElementById('sc-r')!.addEventListener('click', paint);
    // ღილაკით გახსნა (კლავიატურა / ხელმისაწვდომობა): მხოლოდ უჯრები
    document.getElementById('sc-all')!.addEventListener('click', () => { CELLS.forEach((_, i) => clearCell(i)); msg(); });
  }
</script>
