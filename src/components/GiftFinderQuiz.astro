---
import { PRODUCTS, BUNDLES, SETTINGS, inStock } from '../data/catalog';
const cfg = {
  products: PRODUCTS.filter(inStock).map((p) => ({ slug: p.slug, title: p.title, price: p.price, cats: p.categories, img: p.images[0]?.thumb })),
  bundles: BUNDLES.map((b) => ({ size: b.size, price: b.price, free: b.freeShipping, gift: b.gift })),
  fee: SETTINGS.shippingFee,
  freeFrom: SETTINGS.freeShippingFrom,
};
const Q = [
  { id: 'recipient', title: 'ვისთვის ეძებ საჩუქარს?', multi: 0, options: [
    ['friend', 'მეგობრისთვის'], ['colleague', 'კოლეგისთვის / Secret Santa'], ['partner', 'პარტნიორისთვის'], ['child', 'ბავშვისთვის'], ['self', 'ჩემთვის']] },
  { id: 'interests', title: 'რა აინტერესებს ყველაზე მეტად?', help: 'შეგიძლია რამდენიმე ვარიანტი მონიშნო (მაქსიმუმ 4).', multi: 4, exclusive: 'unknown', options: [
    ['watch', 'ფილმები და სერიალები'], ['read', 'წიგნები'], ['travel', 'მოგზაურობა'], ['anime', 'ანიმე და ანიმაცია'], ['experiences', 'ახალი გამოცდილებები'], ['unknown', 'ჯერ არ ვიცი']] },
  { id: 'budget', title: 'რა ბიუჯეტი გაქვს?', help: 'მიწოდების ჩათვლით.', multi: 0, options: [
    ['b30', '30 ₾-მდე'], ['b50', '30–50 ₾'], ['b60', '50–60 ₾'], ['b70', '60–70 ₾'], ['b70plus', '70 ₾-ზე მეტი']] },
  { id: 'styles', title: 'როგორი საჩუქარი გინდა?', help: 'მონიშნე ის თვისებები, რომლებიც შენთვის მნიშვნელოვანია (მაქსიმუმ 3).', multi: 3, options: [
    ['fun', 'სახალისო და ორიგინალური'], ['romantic', 'რომანტიკული'], ['learn', 'შემეცნებითი'], ['decor', 'დეკორატიული'], ['adventure', 'თავგადასავლებით სავსე'], ['motivation', 'პრაქტიკული და მოტივაციური']] },
];
---
<section id="gift-finder" class="section gf" aria-labelledby="gf-h">
  <div class="container">
    <div class="gf-card">
      <div class="gf-intro">
        <span class="eyebrow">საჩუქრის მძებნელი</span>
        <h2 id="gf-h">არ იცი, რომელი აირჩიო?</h2>
        <p>უპასუხე ოთხ კითხვას და შეგირჩევთ პოსტერს ან ნაკრებს შენს ბიუჯეტში. რეგისტრაცია არ სჭირდება.</p>
      </div>

      <form class="gf-quiz" id="gf-quiz" novalidate>
        <div class="gf-progress" aria-hidden="true"><span id="gf-bar"></span></div>
        <p class="gf-step" id="gf-step" aria-live="polite"></p>
        {Q.map((q, i) => (
          <fieldset class="gf-q" data-q={q.id} data-multi={q.multi} data-exclusive={q.exclusive ?? ''} hidden={i > 0}>
            <legend>{q.title}</legend>
            {q.help && <p class="gf-help">{q.help}</p>}
            <div class="gf-opts">
              {q.options.map(([v, l]) => <button type="button" class="gf-opt" data-v={v} aria-pressed="false">{l}</button>)}
            </div>
          </fieldset>
        ))}
        <div class="gf-nav">
          <button type="button" class="btn ghost" id="gf-back">უკან</button>
          <button type="button" class="btn" id="gf-next" disabled>შემდეგი</button>
        </div>
      </form>

      <div class="gf-result" id="gf-result" hidden aria-live="polite">
        <h3>შენი საჩუქრის იდეები მზადაა</h3>
        <p class="gf-why" id="gf-why"></p>
        <div class="gf-picks" id="gf-picks"></div>
        <div class="gf-bundle" id="gf-bundle" hidden></div>
        <div class="gf-again">
          <button type="button" class="btn sm ghost" id="gf-edit">პასუხების შეცვლა</button>
          <button type="button" class="btn sm ghost" id="gf-restart">თავიდან დაწყება</button>
        </div>
      </div>
    </div>
  </div>
</section>
<script type="application/json" id="gf-data" set:html={JSON.stringify(cfg)} />

<style>
  .gf-card { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(24px, 4vw, 56px); padding: clamp(24px, 4vw, 48px); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); }
  .gf-intro h2 { font-size: clamp(28px, 3.2vw, 38px); margin: 10px 0 12px; }
  .gf-intro p { color: var(--muted); margin: 0; }
  .gf-quiz, .gf-result { min-width: 0; }
  .gf-result { grid-column: 2; }
  .gf-progress { height: 4px; border-radius: 2px; background: var(--surface-2); overflow: hidden; }
  .gf-progress span { display: block; height: 100%; width: 25%; background: var(--forest); transition: width .3s var(--ease); }
  .gf-step { margin: 10px 0 18px; font-size: 13px; color: var(--muted); }
  .gf-q { border: 0; margin: 0; padding: 0; min-width: 0; }
  .gf-q legend { font: 600 22px/1.3 var(--display); padding: 0; margin-bottom: 6px; }
  .gf-help { margin: 0 0 14px; font-size: 14px; color: var(--muted); }
  .gf-opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 12px; }
  .gf-opt { min-height: 56px; padding: 12px 16px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface); text-align: left; font-weight: 500; transition: border-color .15s ease, background .15s ease; }
  .gf-opt:hover { border-color: var(--forest); }
  .gf-opt[aria-pressed='true'] { border-color: var(--forest); background: var(--forest-tint); color: var(--forest); font-weight: 600; box-shadow: inset 0 0 0 1px var(--forest); }
  .gf-nav { display: flex; justify-content: space-between; gap: 10px; margin-top: 24px; }
  .gf-result h3 { font-size: 24px; margin: 0 0 6px; }
  .gf-why { margin: 0 0 18px; color: var(--muted); }
  .gf-picks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  :global(.gf-pick) { display: flex; flex-direction: column; gap: 6px; padding: 12px; border: 1px solid var(--border); border-radius: var(--r-md); }
  :global(.gf-pick.main) { border-color: var(--forest); box-shadow: inset 0 0 0 1px var(--forest); }
  :global(.gf-pick img) { width: 100%; aspect-ratio: 640 / 900; object-fit: cover; border-radius: 4px; box-shadow: var(--shadow-sm); }
  :global(.gf-pick .tag) { font-size: 12px; font-weight: 600; color: var(--forest); }
  :global(.gf-pick b) { font: 600 15px/1.3 var(--display); }
  :global(.gf-pick b a) { text-decoration: none; }
  :global(.gf-pick b a:hover) { color: var(--forest); }
  :global(.gf-pick .r) { font-size: 12px; color: var(--muted); }
  :global(.gf-pick .row) { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 6px; padding-top: 6px; }
  .gf-bundle { margin-top: 16px; padding: 16px; border-radius: var(--r-md); background: var(--forest-tint); }
  :global(.gf-bundle .thumbs) { display: flex; gap: 6px; margin: 10px 0; }
  :global(.gf-bundle .thumbs img) { width: 44px; aspect-ratio: 640 / 900; object-fit: cover; border-radius: 3px; box-shadow: var(--shadow-sm); }
  :global(.gf-bundle .head) { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-weight: 600; }
  :global(.gf-bundle .sub) { font-size: 14px; color: var(--muted); }
  .gf-again { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px; }
  @media (max-width: 860px) {
    .gf-card { grid-template-columns: 1fr; } .gf-result { grid-column: 1; }
    .gf-opts { grid-template-columns: 1fr; }
    .gf-picks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :global(.gf-pick.main) { grid-column: 1 / -1; display: grid; grid-template-columns: 110px 1fr; align-items: start; }
    :global(.gf-pick.main img) { grid-row: span 5; }
  }
</style>

<script>
  import { recommend, type Answers, type Config } from '../lib/recommend';
  const cfg = JSON.parse(document.getElementById('gf-data')!.textContent!) as Config;
  const form = document.getElementById('gf-quiz') as HTMLFormElement, result = document.getElementById('gf-result')!;
  const qs = [...form.querySelectorAll<HTMLFieldSetElement>('.gf-q')];
  const next = document.getElementById('gf-next') as HTMLButtonElement, back = document.getElementById('gf-back') as HTMLButtonElement;
  const bar = document.getElementById('gf-bar')!, stepEl = document.getElementById('gf-step')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(2));
  let step = 0;
  const picked = (q: HTMLFieldSetElement) => [...q.querySelectorAll<HTMLButtonElement>('[aria-pressed="true"]')].map((b) => b.dataset.v!);

  function show(i: number) {
    step = i;
    qs.forEach((q, k) => (q.hidden = k !== i));
    bar.style.width = `${((i + 1) / qs.length) * 100}%`;
    stepEl.textContent = `კითხვა ${i + 1} / ${qs.length}`;
    back.style.visibility = i ? 'visible' : 'hidden';
    next.textContent = i === qs.length - 1 ? 'შედეგის ნახვა' : 'შემდეგი';
    next.disabled = !picked(qs[i]).length;
  }

  form.addEventListener('click', (e) => {
    const opt = (e.target as HTMLElement).closest<HTMLButtonElement>('.gf-opt'); if (!opt) return;
    const q = opt.closest<HTMLFieldSetElement>('.gf-q')!, multi = Number(q.dataset.multi), ex = q.dataset.exclusive;
    const opts = [...q.querySelectorAll<HTMLButtonElement>('.gf-opt')], on = opt.getAttribute('aria-pressed') !== 'true';
    if (!multi) opts.forEach((o) => o.setAttribute('aria-pressed', String(o === opt)));
    else {
      if (on && ex && opt.dataset.v === ex) opts.forEach((o) => o.setAttribute('aria-pressed', 'false')); // "not sure" clears the rest
      if (on && ex && opt.dataset.v !== ex) q.querySelector(`[data-v="${ex}"]`)?.setAttribute('aria-pressed', 'false');
      if (on && picked(q).length >= multi) { window.dispatchEvent(new CustomEvent('toast', { detail: `მაქსიმუმ ${multi} ვარიანტი` })); return; }
      opt.setAttribute('aria-pressed', String(on));
    }
    next.disabled = !picked(q).length;
    if (!multi) setTimeout(() => go(), 220); // single choice moves on by itself; answers stay editable with "back"
  });

  function go() {
    if (!picked(qs[step]).length) return;
    if (step < qs.length - 1) return show(step + 1);
    render();
  }
  next.addEventListener('click', go);
  back.addEventListener('click', () => step > 0 && show(step - 1));

  const card = (p: { slug: string; title: string; price: number; img?: string }, reasons: string[], tag?: string) => `
    <article class="gf-pick${tag ? ' main' : ''}">
      ${p.img ? `<img src="${esc(p.img)}" alt="" loading="lazy" width="640" height="900">` : ''}
      ${tag ? `<span class="tag">${esc(tag)}</span>` : ''}
      <b><a href="/product/${esc(p.slug)}">${esc(p.title)}</a></b>
      ${reasons.length ? `<span class="r">${esc(reasons.join(' · '))}</span>` : ''}
      <div class="row"><span class="price">${fmt(p.price)} ₾</span><button type="button" class="btn sm ghost" data-add="${esc(p.slug)}">კალათაში</button></div>
    </article>`;

  function render() {
    const a: Answers = {
      recipient: picked(qs[0])[0] as Answers['recipient'],
      interests: picked(qs[1]) as Answers['interests'],
      budget: picked(qs[2])[0] as Answers['budget'],
      styles: picked(qs[3]) as Answers['styles'],
    };
    const r = recommend(cfg, a);
    form.hidden = true; result.hidden = false;
    const why = document.getElementById('gf-why')!, picks = document.getElementById('gf-picks')!, bundle = document.getElementById('gf-bundle')!;
    if (!r.primary) {
      why.textContent = 'ამ ბიუჯეტში შესაფერისი პოსტერი ვერ ვიპოვეთ. სცადე ბიუჯეტის შეცვლა.';
      picks.innerHTML = ''; bundle.hidden = true;
    } else {
      why.textContent = r.fallback
        ? 'ზუსტი დამთხვევა ამ ბიუჯეტში არ არის, ამიტომ გთავაზობთ საუკეთესოს, რაც ბიუჯეტში ეტევა.'
        : 'შენი არჩევანის მიხედვით, ეს პოსტერები ყველაზე მეტად შეესაბამება მონიშნულ ინტერესებს.';
      picks.innerHTML = card(r.primary.product, r.primary.reasons, 'მთავარი რჩევა') + r.alternatives.map((x) => card(x.product, x.reasons)).join('');
      const b = r.bundle;
      bundle.hidden = !b;
      if (b) {
        bundle.innerHTML = `<div class="head"><span>${b.size} პოსტერიანი ნაკრები — ${fmt(b.price)} ₾</span><span>სულ ${fmt(b.total)} ₾</span></div>
          <div class="sub">${b.free ? 'უფასო მიწოდება' : 'მიწოდების ჩათვლით'}${b.gift ? ' + საჩუქარი' : ''}${b.save > 0 ? ` · დაზოგე ${fmt(b.save)} ₾` : ''}</div>
          <div class="thumbs">${b.items.map((p) => (p.img ? `<img src="${esc(p.img)}" alt="${esc(p.title)}" title="${esc(p.title)}" loading="lazy">` : '')).join('')}</div>
          <button type="button" class="btn sm" id="gf-take" data-items="${esc(b.items.map((p) => p.slug).join(','))}" data-size="${b.size}">ნაკრები კალათაში</button>`;
      }
    }
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  result.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('#gf-take'); if (!t) return;
    window.dispatchEvent(new CustomEvent('bb:set', { detail: { size: Number(t.dataset.size), chosen: t.dataset.items!.split(',') } }));
  });
  document.getElementById('gf-edit')!.addEventListener('click', () => { result.hidden = true; form.hidden = false; show(0); });
  document.getElementById('gf-restart')!.addEventListener('click', () => {
    form.querySelectorAll('.gf-opt').forEach((o) => o.setAttribute('aria-pressed', 'false'));
    result.hidden = true; form.hidden = false; show(0);
  });
  show(0);
</script>
