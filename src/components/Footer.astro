---
import Logo from './Logo.astro';
import { SETTINGS, localImage } from '../data/catalog';
import { siFacebook, siInstagram, siTiktok } from 'simple-icons';
const tel = '+995' + SETTINGS.phone.replace(/\s/g, '');
const s = SETTINGS.socials as Record<string, string>;
const LOGO_SRC = 'https://scratchme.ge/logo-wordmark-dark.webp';
const logo = localImage(LOGO_SRC)?.lg;
// სოც. ქსელები: ბმული ადმინის პარამეტრებიდან, ცარიელი არ ჩანს
const socials = [
  { key: 'instagram', name: 'Instagram', icon: siInstagram },
  { key: 'tiktok', name: 'TikTok', icon: siTiktok },
  { key: 'facebook', name: 'Facebook', icon: siFacebook },
].filter((x) => s[x.key]);
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="container">
    <div class="cta">
      <div>
        <span class="eyebrow">გადაფხიკე / აღმოაჩინე</span>
        <p>შენი შემდეგი თავგადასავალი კედელზე გელოდება.</p>
      </div>
      <div class="cta-b">
        <a href="/shop" class="btn light">ნახე პოსტერები</a>
        <a href="/#bundle-builder" class="btn outline">ააწყვე ნაკრები</a>
      </div>
    </div>

    <div class="grid">
      <div class="brand">
        <a href="/" class="sticker" aria-label="scratchme.ge — მთავარი">
          {logo ? <img src={logo} alt="scratchme.ge" width="676" height="150" loading="lazy" /> : <Logo size={30} />}
        </a>
        <p class="tag">შენი კედელი უფრო შენსავით რომ გახდეს. გადაფხიკე, აღმოაჩინე, გაიხსენე.</p>
        <p class="made">დამზადებულია საქართველოში</p>
      </div>
      <nav aria-label="აღმოაჩინე">
        <h3>აღმოაჩინე</h3>
        <a href="/shop">ყველა პოსტერი</a><a href="/#bundle-builder">ააწყვე ნაკრები</a><a href="/#how-it-works">როგორ მუშაობს</a><a href="/secret-santa">სეკრეტ სანტას საჩუქრები</a><a href="/#faq">ხშირი კითხვები</a><a href="/blog">ბლოგი</a>
      </nav>
      <div>
        <h3>დახმარება</h3>
        <a href={`tel:${tel}`} >{SETTINGS.phone}</a>
        <a href={`mailto:${SETTINGS.email}`} >{SETTINGS.email}</a>
        <span >{SETTINGS.address}</span>
        <a href="/contact" >კონტაქტი</a>
      </div>
      {socials.length > 0 && (
        <div>
          <h3>გამოგვყევი</h3>
          <div class="soc">
            {socials.map((x) => (
              <a href={s[x.key]} target="_blank" rel="noopener" aria-label={x.name} title={x.name}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={x.icon.path} /></svg>
              </a>
            ))}
          </div>
          <p class="soc-note">ახალი პოსტერები, გათამაშებები და გადაფხეკილი კედლები</p>
        </div>
      )}
    </div>
  </div>
  <div class="container bottom">
    <span>© {year} scratchme.ge</span>
    <span class="legal"><a href="/privacy-policy">კონფიდენციალურობა</a><a href="/terms">წესები და პირობები</a><a href="/delivery-returns">მიწოდება და დაბრუნება</a></span>
  </div>
</footer>
<style>
  .ft { margin-top: clamp(48px, 7vw, 88px); background: #1F3730; color: #EEF1EC; padding: 0 0 24px; }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 18px 28px; flex-wrap: wrap; padding: 48px 0 40px; border-bottom: 1px solid rgba(238,241,236,.14); margin-bottom: 40px; }
  .cta .eyebrow { color: #A9C2B5; }
  .cta p { margin: 6px 0 0; font: 600 clamp(22px, 2.6vw, 32px)/1.2 var(--display); color: #fff; }
  .cta-b { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn.light { background: #fff; border-color: #fff; color: var(--forest); }
  .btn.light:hover { background: var(--forest-tint); border-color: var(--forest-tint); }
  .btn.outline { background: transparent; border-color: rgba(255,255,255,.5); color: #fff; }
  .btn.outline:hover { border-color: #fff; background: rgba(255,255,255,.06); }

  .grid { display: grid; grid-template-columns: 1.3fr .9fr 1.3fr 1fr; gap: 32px; }
  .sticker { display: inline-block; width: fit-content; line-height: 0; padding: 10px 14px; background: #fff; border-radius: var(--r-sm); }
  .sticker img { display: block; height: 40px; width: 180px; max-width: none; object-fit: contain; }
  .tag { max-width: 320px; color: #C9D3CC; margin: 18px 0 8px; }
  .made { margin: 0; font-size: 13px; color: #A9C2B5; }
  h3 { font-size: 14px; font-weight: 600; margin: 0 0 14px; color: #A9C2B5; letter-spacing: 0; }
  nav a, .grid > div > a, .grid > div > span { display: block; margin: 0 0 10px; color: #E3E9E4; text-decoration: none; font-size: 15px; }
  nav a:hover, .grid > div > a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  .soc { display: flex; gap: 10px; flex-wrap: wrap; }
  .soc a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(238,241,236,.3); color: #fff; transition: background .15s ease, border-color .15s ease; }
  .soc a:hover { background: rgba(255,255,255,.1); border-color: #fff; }
  .soc svg { width: 19px; height: 19px; fill: currentColor; }
  .soc-note { font-size: 13px; color: #A9C2B5; margin: 14px 0 0; max-width: 220px; }

  .bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 40px; padding-top: 18px; border-top: 1px solid rgba(238,241,236,.14); font-size: 13px; color: #A9C2B5; }
  .legal { display: flex; gap: 16px; flex-wrap: wrap; } .legal a { text-decoration: none; color: inherit; } .legal a:hover { color: #fff; text-decoration: underline; }
  .ft :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; gap: 26px; } .cta { padding: 36px 0 30px; } .cta-b { width: 100%; } .cta-b .btn { flex: 1; padding: 0 10px; }
    .bottom { flex-direction: column; }
  }
</style>
