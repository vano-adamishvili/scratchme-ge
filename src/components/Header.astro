---
import Logo from './Logo.astro';
import { SETTINGS, CATEGORIES, PRODUCTS, localImage } from '../data/catalog';
const nav = [
  { href: '/shop', label: 'პოსტერები' },
  { href: '/#bundle-builder', label: 'ნაკრების აწყობა' },
  { href: '/#how-it-works', label: 'როგორ მუშაობს' },
];
// only categories that have at least one active poster
const cats = CATEGORIES.filter((c) => PRODUCTS.some((p) => p.categories.includes(c.id)));
const LOGO_SRC = 'https://scratchme.ge/logo-wordmark-dark.webp';
const LOGO = localImage(LOGO_SRC)?.lg ?? LOGO_SRC;
---
<header class="nav" id="site-header">
  <div class="container in">
    <a href="/" class="brand" aria-label="scratchme.ge — მთავარი">
      <img class="lg" src={LOGO} alt="scratchme.ge" width="676" height="150" decoding="async" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
      <span hidden><Logo /></span>
    </a>
    <nav class="links" aria-label="მთავარი მენიუ">
      <a href={nav[0].href}>{nav[0].label}</a>
      <div class="dd">
        <button type="button" class="dd-btn" aria-expanded="false" aria-controls="cat-menu">კატეგორიები
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="dd-menu" id="cat-menu" hidden>
          {cats.map((c) => <a href={`/shop/${c.id}`}>{c.name}</a>)}
          <a href="/shop" class="all">ყველა პოსტერი →</a>
        </div>
      </div>
      {nav.slice(1).map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="right">
      <a href="/cart" class="cart" aria-label="კალათა">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        <span class="n" data-cart-count hidden>0</span>
      </a>
      <button class="burger" aria-label="მენიუ" aria-expanded="false" aria-controls="mnav">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <nav id="mnav" class="mnav" hidden aria-label="მობილური მენიუ">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <span class="mnav-h">კატეგორიები</span>
    <div class="mnav-cats">{cats.map((c) => <a href={`/shop/${c.id}`} class="chip">{c.name}</a>)}</div>
    <a href={`tel:+995${SETTINGS.phone.replace(/\s/g, '')}`} class="tel">{SETTINGS.phone}</a>
  </nav>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 40; background: rgba(248, 246, 241, .92); backdrop-filter: saturate(1.4) blur(14px); border-bottom: 1px solid transparent; transition: border-color .2s ease, box-shadow .2s ease; }
  .nav.scrolled { border-bottom-color: var(--border); box-shadow: 0 1px 12px rgba(37, 42, 39, .05); }
  .in { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: flex; align-items: center; text-decoration: none; }
  .lg { height: 40px; width: auto; max-width: 180px; object-fit: contain; border-radius: 6px; }
  .links { display: flex; align-items: center; gap: 4px; }
  .links > a, .dd-btn { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 14px; border: 0; border-radius: 10px; background: none; color: var(--text); text-decoration: none; font-weight: 500; font-size: 15px; transition: background .15s ease, color .15s ease; }
  .links > a:hover, .dd-btn:hover, .dd-btn[aria-expanded='true'] { background: var(--surface-2); color: var(--forest); }
  .dd { position: relative; }
  .dd-btn svg { transition: transform .2s ease; }
  .dd-btn[aria-expanded='true'] svg { transform: rotate(180deg); }
  .dd-menu { position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); min-width: 240px; display: grid; padding: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); box-shadow: var(--shadow-lg); }
  .dd-menu a { padding: 10px 12px; border-radius: 10px; text-decoration: none; font-size: 15px; }
  .dd-menu a:hover { background: var(--forest-tint); color: var(--forest); }
  .dd-menu .all { margin-top: 4px; border-top: 1px solid var(--border); border-radius: 0 0 10px 10px; color: var(--forest); font-weight: 600; }
  .right { display: flex; align-items: center; gap: 8px; }
  .cart, .burger { position: relative; display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface); color: var(--forest); transition: border-color .15s ease, background .15s ease; }
  .cart:hover, .burger:hover { border-color: var(--forest); background: var(--forest-tint); }
  .cart .n { position: absolute; top: -6px; right: -6px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 10px; background: var(--forest); color: #fff; font: 600 11px/20px var(--sans); text-align: center; }
  .cart.pop { animation: pop .4s var(--ease); }
  @keyframes pop { 40% { transform: scale(1.1); } }
  .burger { display: none; }
  /* მობილური მენიუ გვერდის ზემოთ იშლება (overlay) — კონტენტი არ ხტება */
  .mnav { position: absolute; left: 0; right: 0; top: 100%; max-height: calc(100dvh - 64px); overflow-y: auto; overscroll-behavior: contain; display: grid; align-content: start; gap: 2px; padding: 8px 20px 20px; border-top: 1px solid var(--border); background: var(--cream-bg); box-shadow: 0 18px 30px -12px rgba(37, 42, 39, .25); }
  .mnav[hidden] { display: none; }
  .mnav > a { padding: 14px 0; border-bottom: 1px solid var(--border); text-decoration: none; font-weight: 600; font-size: 17px; }
  .mnav-h { margin: 16px 0 8px; font-size: 13px; font-weight: 600; color: var(--muted); }
  .mnav-cats { display: flex; flex-wrap: wrap; gap: 8px; }
  .mnav .tel { margin-top: 14px; border: 0; color: var(--forest); }
  @media (max-width: 900px) { .links { display: none; } .burger { display: grid; } .in { min-height: 64px; } .lg { height: 34px; max-width: 150px; } }
</style>
<script>
  import { pushLayer, popLayer } from '../lib/backstack';
  const header = document.getElementById('site-header')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

  const cartEl = header.querySelector<HTMLElement>('.cart');
  window.addEventListener('cart', () => { if (!cartEl) return; cartEl.classList.remove('pop'); void cartEl.offsetWidth; cartEl.classList.add('pop'); });

  // categories dropdown: click to open, Escape / outside click to close
  const ddBtn = header.querySelector<HTMLButtonElement>('.dd-btn')!, dd = document.getElementById('cat-menu')!;
  const setDd = (open: boolean) => { dd.hidden = !open; ddBtn.setAttribute('aria-expanded', String(open)); };
  ddBtn.addEventListener('click', () => setDd(dd.hidden));
  document.addEventListener('click', (e) => { if (!dd.hidden && !(e.target as HTMLElement).closest('.dd')) setDd(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !dd.hidden) { setDd(false); ddBtn.focus(); } });

  const b = header.querySelector<HTMLButtonElement>('.burger')!, m = document.getElementById('mnav')!;
  const setMenu = (open: boolean) => { m.hidden = !open; b.setAttribute('aria-expanded', String(open)); };
  b.addEventListener('click', () => {
    if (m.hidden) { pushLayer('menu', () => setMenu(false)); setMenu(true); }
    else { setMenu(false); popLayer('menu'); }
  });
  // მენიუს გარეთ დაჭერა ან Escape მენიუს ხურავს
  document.addEventListener('click', (e) => { if (!m.hidden && !(e.target as HTMLElement).closest('.nav')) { setMenu(false); popLayer('menu'); } });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !m.hidden) { setMenu(false); popLayer('menu'); b.focus(); } });
  // მენიუს ბმული: ჯერ მენიუს history-ჩანაწერს ვაშორებთ, მერე გადავდივართ — „უკან“ იქ დაგაბრუნებს, საიდანაც წახვედი
  m.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a');
    if (!a || a.target === '_blank' || a.href.startsWith('tel:') || a.href.startsWith('mailto:')) return;
    e.preventDefault(); setMenu(false); popLayer('menu', a.href);
  });
</script>
