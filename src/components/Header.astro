---
import Logo from './Logo.astro';
import { SETTINGS, BUNDLES } from '../data/catalog';
const nav = [
  { href: '/shop', label: 'პოსტერები' },
  { href: '/#bundle-builder', label: 'ნაკრები' },
  { href: '/#how-it-works', label: 'როგორ მუშაობს' },
  { href: '/blog', label: 'ბლოგი' },
  { href: '/contact', label: 'კონტაქტი' },
];
const b2 = BUNDLES.find((b) => b.size === 2);
const free = BUNDLES.find((b) => b.freeShipping);
const gift = BUNDLES.find((b) => b.gift);
---
<div class="announce">
  <span class="offer o1">{b2?.size} პოსტერი — {b2?.price} ₾</span>
  {free && <span class="offer o2">{free.size}+ პოსტერზე უფასო მიტანა</span>}
  {gift && <span class="offer o3">{gift.size} პოსტერზე საჩუქარი 🎁</span>}
</div>
<header class="nav">
  <div class="container in">
    <a href="/" class="brand" aria-label="scratchme.ge — მთავარი"><Logo /></a>
    <nav class="links" aria-label="მთავარი მენიუ">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="right">
      <a href="/cart" class="cart" aria-label="კალათა">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 2H2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
        <span class="n" data-cart-count hidden>0</span>
      </a>
      <button class="burger" aria-label="მენიუ" aria-expanded="false" aria-controls="mnav">☰</button>
    </div>
  </div>
  <nav id="mnav" class="mnav" hidden>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href={`tel:+995${SETTINGS.phone.replace(/\s/g, '')}`}>📞 {SETTINGS.phone}</a>
  </nav>
</header>
<style>
  .announce { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; padding: 7px 12px; background: var(--ink); border-bottom: 2px solid var(--coral); font: 600 11px/1.2 var(--mono); }
  .offer { padding: 5px 9px; border: 1px solid var(--ink); color: var(--ink); box-shadow: 3px 3px 0 rgba(247,245,238,.25); white-space: nowrap; }
  .o1 { background: var(--lime); } .o2 { background: var(--yellow); } .o3 { background: var(--coral); }
  .nav { position: sticky; top: 0; z-index: 40; background: rgba(247,245,238,.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .in { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  .brand { text-decoration: none; }
  .links { display: flex; gap: 22px; }
  .links a { text-decoration: none; font-weight: 600; font-size: 15px; opacity: .8; }
  .links a:hover { opacity: 1; text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .right { display: flex; align-items: center; gap: 8px; }
  .cart { position: relative; display: grid; place-items: center; width: 46px; height: 46px; border: 1.5px solid var(--ink); background: #fff; box-shadow: 3px 3px 0 var(--ink); }
  .cart .n { position: absolute; top: -9px; right: -9px; min-width: 22px; height: 22px; padding: 0 5px; border-radius: 11px; background: var(--coral); border: 1.5px solid var(--ink); font: 700 12px/19px var(--mono); text-align: center; }
  .burger { display: none; width: 46px; height: 46px; border: 1.5px solid var(--ink); background: var(--lime); font-size: 20px; box-shadow: 3px 3px 0 var(--ink); }
  .mnav { display: grid; border-top: 1px solid var(--line); background: var(--paper); }
  .mnav[hidden] { display: none; }
  .mnav a { padding: 14px 16px; border-bottom: 1px solid var(--line); text-decoration: none; font-weight: 700; }
  @media (max-width: 860px) { .links { display: none; } .burger { display: block; } .offer.o3 { display: none; } }
</style>
<script>
  const b = document.querySelector<HTMLButtonElement>('.burger')!, m = document.getElementById('mnav')!;
  b.addEventListener('click', () => { const o = m.hidden; m.hidden = !o; b.setAttribute('aria-expanded', String(o)); });
  m.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) { m.hidden = true; b.setAttribute('aria-expanded', 'false'); } });
</script>
