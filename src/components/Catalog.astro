---
import ProductCard from './ProductCard.astro';
import { PRODUCTS, CATEGORIES } from '../data/catalog';
interface Props { heading?: boolean }
const { heading = true } = Astro.props;
const cats = CATEGORIES.filter((c) => PRODUCTS.some((p) => p.categories.includes(c.id)));
---
<section id="catalog" class="section">
  <div class="container">
    {heading && (
      <div class="section-head">
        <div><span class="eyebrow">კატალოგი · {PRODUCTS.length} პოსტერი</span><h2>აირჩიე შენი შემდეგი თავგადასავალი</h2></div>
        <p>მოგზაურობა, ფილმები, წიგნები თუ წყვილების გამოწვევები — თითოეული უჯრა ახალ გეგმას ელოდება.</p>
      </div>
    )}
    <div class="filters" role="toolbar" aria-label="კატეგორიები">
      <button type="button" class="chip on" data-f="">ყველა</button>
      {cats.map((c) => <button type="button" class="chip" data-f={c.id}>{c.emoji} {c.name}</button>)}
    </div>
    <div class="grid">
      {PRODUCTS.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
    </div>
  </div>
</section>
<style>
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
  @media (max-width: 520px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
</style>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('#catalog .chip');
  const cards = document.querySelectorAll<HTMLElement>('#catalog [data-cats]');
  const apply = (f: string, push = true) => {
    chips.forEach((c) => c.classList.toggle('on', c.dataset.f === f));
    cards.forEach((c) => (c.style.display = !f || c.dataset.cats!.split(' ').includes(f) ? '' : 'none'));
    if (push) { const u = new URL(location.href); f ? u.searchParams.set('category', f) : u.searchParams.delete('category'); history.replaceState(null, '', u); }
  };
  chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.f!)));
  const q = new URLSearchParams(location.search).get('category');
  if (q) apply(q, false);
</script>
