---
import '@fontsource/noto-sans-georgian/400.css';
import '@fontsource/noto-sans-georgian/600.css';
import '@fontsource/noto-sans-georgian/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Zoom from '../components/Zoom.astro';

interface Props { title: string; description: string; image?: string; type?: string; noindex?: boolean; jsonLd?: object }
const { title, description, image = '/og-image.png', type = 'website', noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const og = new URL(image, Astro.site);
const fullTitle = title.includes('scratchme') ? title : `${title} | scratchme.ge`;
---
<!doctype html>
<html lang="ka">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f7f5ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://scratchme.ge" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="ka_GE" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="sr-only" href="#main">მთავარ შიგთავსზე გადასვლა</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div id="toast" role="status" aria-live="polite"></div>
    <Zoom />
    <script>
      import { count, addProduct } from '../lib/cart';
      const t = document.getElementById('toast')!;
      let timer = 0;
      window.addEventListener('toast', (e) => {
        t.textContent = (e as CustomEvent).detail; t.classList.add('show');
        clearTimeout(timer); timer = window.setTimeout(() => t.classList.remove('show'), 2400);
      });
      const paint = () => document.querySelectorAll('[data-cart-count]').forEach((el) => { const n = count(); el.textContent = String(n); (el as HTMLElement).hidden = !n; });
      paint(); window.addEventListener('cart', paint); window.addEventListener('storage', paint);
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-add]');
        if (!b) return;
        e.preventDefault();
        const qtyEl = b.dataset.qty ? document.querySelector<HTMLInputElement>(b.dataset.qty) : null;
        addProduct(b.dataset.add!, qtyEl ? Number(qtyEl.value) || 1 : 1);
        window.dispatchEvent(new CustomEvent('toast', { detail: 'კალათაშია ✓' }));
      });
    </script>
  </body>
</html>
