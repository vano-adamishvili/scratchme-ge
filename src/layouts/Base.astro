---
import '@fontsource/noto-sans-georgian/400.css';
import '@fontsource/noto-sans-georgian/500.css';
import '@fontsource/noto-sans-georgian/600.css';
import '@fontsource/noto-sans-georgian/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Zoom from '../components/Zoom.astro';
import FloatingGiftOffers from '../components/FloatingGiftOffers.astro';

interface Props { title: string; description: string; image?: string; type?: string; noindex?: boolean; jsonLd?: object }
const { title, description, image = '/og-image.png', type = 'website', noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const og = new URL(image, Astro.site);
const fullTitle = title.includes('scratchme') ? title : `${title} | scratchme.ge`;
---
<!doctype html>
<html lang="ka">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F8F6F1" />
    <link rel="preload" href="/fonts/firago-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="ka_GE" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="sr-only" href="#main">მთავარ შიგთავსზე გადასვლა</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div id="toast" role="status" aria-live="polite"></div>
    <Zoom />
    {!Astro.url.pathname.startsWith('/cart') && <FloatingGiftOffers />}
    <div id="obar" class="obar" role="status" aria-live="polite" hidden>
      <div class="ob-t"><span class="ob-e">კალათაშია ✓ ნაკრებად უფრო იაფია</span><b id="ob-b"></b><span id="ob-s" class="ob-s"></span></div>
      <div class="ob-a"><button type="button" class="btn sm" id="ob-apply">ნაკრებად ქცევა</button><a href="/cart" class="btn sm ghost">კალათა</a></div>
      <button type="button" class="ob-x" id="ob-x" aria-label="დახურვა">×</button>
    </div>
    <script>
      import { count, addProduct, read, write } from '../lib/cart';
      import { bundleOffer, applyBundle } from '../lib/pricing';
      import { SETTINGS } from '../data/catalog';
      const t = document.getElementById('toast')!;
      let timer = 0;
      window.addEventListener('toast', (e) => {
        t.textContent = (e as CustomEvent).detail; t.classList.add('show');
        clearTimeout(timer); timer = window.setTimeout(() => t.classList.remove('show'), 2400);
      });
      const paint = () => document.querySelectorAll('[data-cart-count]').forEach((el) => { const n = count(); el.textContent = String(n); (el as HTMLElement).hidden = !n; });
      paint(); window.addEventListener('cart', paint); window.addEventListener('storage', paint);
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-add]');
        if (!b) return;
        e.preventDefault();
        const qtyEl = b.dataset.qty ? document.querySelector<HTMLInputElement>(b.dataset.qty) : null;
        addProduct(b.dataset.add!, qtyEl ? Number(qtyEl.value) || 1 : 1);
        // ცალკე პოსტერები ნაკრებად უფრო იაფია → ვთავაზობთ გადაყვანას
        const o = bundleOffer(read());
        if (o) showOffer(o); else window.dispatchEvent(new CustomEvent('toast', { detail: 'კალათაშია ✓' }));
      });
      const bar = document.getElementById('obar')!;
      let cur: ReturnType<typeof bundleOffer> = null, obTimer = 0;
      const money = (n: number) => `${Number.isInteger(n) ? n : n.toFixed(2)} ₾`;
      const hideOffer = () => { bar.classList.remove('show'); window.setTimeout(() => { if (!bar.classList.contains('show')) bar.hidden = true; }, 250); };
      function showOffer(o: NonNullable<ReturnType<typeof bundleOffer>>) {
        cur = o;
        const gift = SETTINGS.gifts.find((g) => g.active && g.stock > 0);
        document.getElementById('ob-b')!.innerHTML = `${o.size} პოსტერი ნაკრებად: <s>${money(o.before)}</s> → ${money(o.after)}`;
        document.getElementById('ob-s')!.textContent = `დაზოგე ${money(o.save)}${o.freeShipping ? ' · მიწოდება უფასოა' : ''}${o.gift && gift ? ' · საჩუქრად ' + gift.name : ''}`;
        bar.hidden = false; requestAnimationFrame(() => bar.classList.add('show'));
        clearTimeout(obTimer); obTimer = window.setTimeout(hideOffer, 10000);
      }
      document.getElementById('ob-x')!.addEventListener('click', hideOffer);
      document.getElementById('ob-apply')!.addEventListener('click', () => {
        if (!cur) return;
        const gift = cur.gift ? SETTINGS.gifts.find((g) => g.active && g.stock > 0)?.id : undefined;
        write(applyBundle(read(), cur.size, cur.items.map((i) => i.slug), gift));
        hideOffer(); window.dispatchEvent(new CustomEvent('toast', { detail: `ნაკრებად გადაკეთდა ✓ სულ ${money(cur.after)}` }));
      });
    </script>
  </body>
</html>
