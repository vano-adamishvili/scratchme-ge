---
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.astro';
import BundleBuilder from '../components/BundleBuilder.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Hero from '../components/Hero.astro';
import GiftFinderQuiz from '../components/GiftFinderQuiz.astro';
import ProductDetails from '../components/ProductDetails.astro';
import SocialProof from '../components/SocialProof.astro';
import FAQ from '../components/FAQ.astro';
import { organization, website } from '../lib/seo';
import { PRODUCTS, BUNDLES, SETTINGS } from '../data/catalog';
const ld = [organization(), website()];
const prices = PRODUCTS.map((p) => p.price), lo = Math.min(...prices), hi = Math.max(...prices);
const desc = `თემატური გადასაფხეკი პოსტერები ფილმების, წიგნების, მოგზაურობისა და ანიმეს მოყვარულებისთვის. ${SETTINGS.product.size}, ${lo === hi ? lo : `${lo}–${hi}`} ₾, ნაკრები ${BUNDLES[0].size} პოსტერი ${BUNDLES[0].price} ₾-დან. მიწოდება მთელ საქართველოში.`;
---
<Base fullTitle title="გადასაფხეკი პოსტერები — ორიგინალური საჩუქარი | ScratchMe" description={desc} jsonLd={ld}>
  <Hero />
  <Catalog />
  <BundleBuilder />
  <GiftFinderQuiz />
  <HowItWorks />
  <ProductDetails />
  <SocialProof />
  <FAQ />
</Base>
