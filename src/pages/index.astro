---
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.astro';
import BundleBuilder from '../components/BundleBuilder.astro';
import HowItWorks from '../components/HowItWorks.astro';
const ld = { '@context': 'https://schema.org', '@type': 'Store', name: 'scratchme.ge', url: 'https://scratchme.ge', description: 'გადასაფხეკი პოსტერები — ფილმები, წიგნები, მოგზაურობა და გამოწვევები.', address: { '@type': 'PostalAddress', addressLocality: 'Tbilisi', addressCountry: 'GE' } };
---
<Base title="scratchme.ge — გადასაფხეკი პოსტერები" description="გადასაფხეკი პოსტერები ფილმების, წიგნების, მოგზაურობისა და გამოწვევების მოყვარულებისთვის. გადაფხიკე, აღმოაჩინე, გაიხსენე. მიტანა მთელ საქართველოში." jsonLd={ld}>
  <section class="hero">
    <div class="copy">
      <span class="eyebrow">გადაფხიკე / აღმოაჩინე</span>
      <h1>აქციე კედელი შენს ისტორიად.</h1>
      <p>პოსტერები, რომლებიც შენთან ერთად იცვლება — გადაფხიკე და ფერადად აღნიშნე ნანახი ფილმები, წაკითხული წიგნები და გავლილი გზები.</p>
    </div>
    <a href="#bundle-builder" class="btn coral">ააწყე ნაკრები</a>
  </section>
  <Catalog heading={false} />
  <BundleBuilder />
  <HowItWorks />
</Base>
<style>
  .hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding: clamp(20px, 4vw, 48px) clamp(16px, 6vw, 80px); border-bottom: 1px solid var(--line); }
  h1 { font-size: clamp(30px, 5vw, 64px); line-height: .95; letter-spacing: -.05em; margin: 10px 0 12px; max-width: 720px; }
  .copy p { font-size: 16px; color: #57564e; max-width: 560px; margin: 0; }
  @media (max-width: 860px) { .copy p { display: none; } h1 { margin-bottom: 0; } .hero { gap: 14px; } }
  :global(#catalog) { padding-top: clamp(16px, 3vw, 32px); }
</style>
