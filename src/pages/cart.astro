---
import Base from '../layouts/Base.astro';
import { SETTINGS } from '../data/catalog';
---
<Base title="კალათა" description="შენი კალათა და შეკვეთის გაფორმება." noindex>
  <div class="container page-head"><span class="eyebrow">შეკვეთა</span><h1 id="h">კალათა</h1></div>
  <div class="container">
    <div id="empty" class="empty card" hidden>
      <p>კალათა ცარიელია.</p>
      <a href="/shop" class="btn">პოსტერების ნახვა</a>
      <a href="/#bundle-builder" class="link">ან ააწყვე ნაკრები →</a>
    </div>
    <div id="full" class="layout" hidden>
      <div>
        <div id="offer" class="offer" hidden></div>
        <ul id="lines" class="lines"></ul>
        <form id="form" class="form card" novalidate>
          <h2>მიწოდების ინფორმაცია</h2>
          <label class="field">სახელი და გვარი<input name="name" autocomplete="name" required /></label>
          <label class="field">ტელეფონი<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="5XX XX XX XX" required /></label>
          <div class="two">
            <label class="field">ქალაქი<input name="city" value="თბილისი" autocomplete="address-level2" /></label>
            <label class="field">მისამართი<input name="address" autocomplete="street-address" required /></label>
          </div>
          <label class="field">კომენტარი (არასავალდებულო)<textarea name="notes" placeholder="მაგ. როდის გხვდებათ კურიერი"></textarea></label>
          <input name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <fieldset class="banks">
            <legend>გადახდა საბანკო გადარიცხვით</legend>
            {SETTINGS.banks.map((b, i) => <label class="chip"><input type="radio" name="bank" value={b.id} checked={i === 0} /> {b.name}</label>)}
          </fieldset>
          <p class="err" id="err" role="alert"></p>
          <button class="btn" id="submit">შეკვეთის გაფორმება</button>
          <p class="muted small">შეკვეთის შემდეგ გაჩვენებთ ანგარიშის ნომერს. შეკვეთა დადასტურდება გადახდის შემდეგ, ჩვენ დაგიკავშირდებით.</p>
        </form>
      </div>
      <aside class="sum card">
        <h2>ჯამი</h2>
        <div class="r"><span>პროდუქტები</span><b id="sub"></b></div>
        <div class="r"><span>მიტანა</span><b id="ship"></b></div>
        <div class="r tot"><span>სულ</span><b id="tot"></b></div>
        <div class="prog" id="prog" hidden>
          <p class="pm" id="pm"></p>
          <div class="bar" aria-hidden="true"><span id="pbar"></span><i style="left:75%"></i></div>
          <div class="ms"><span id="m3">{SETTINGS.freeShippingFrom} — უფასო მიწოდება</span><span id="m4">4 — საჩუქარი</span></div>
        </div>
        <p class="muted small" id="tip"></p>
      </aside>
    </div>
    <div id="done" class="done card" hidden>
      <span class="eyebrow">მადლობა!</span>
      <h2>შეკვეთა მიღებულია — <span id="ref"></span></h2>
      <p>გადაიხადე <b id="d-total"></b> ამ ანგარიშზე და დანიშნულებაში მიუთითე შეკვეთის ნომერი:</p>
      <dl class="bank">
        <dt>ბანკი</dt><dd id="d-bank"></dd>
        <dt>მიმღები</dt><dd id="d-recv"></dd>
        <dt>IBAN</dt><dd><code id="d-iban"></code> <button type="button" class="btn sm ghost" id="copy">კოპირება</button></dd>
      </dl>
      <p>გადახდის შემდეგ დაგიკავშირდებით მიტანის დროის დასაზუსტებლად. კითხვებისთვის: <a href={`tel:+995${SETTINGS.phone.replace(/\s/g, '')}`}>{SETTINGS.phone}</a>{SETTINGS.socials.messenger && <> · <a href={SETTINGS.socials.messenger} target="_blank" rel="noopener">მოგვწერე Messenger-ში</a></>}</p>
      <a href="/shop" class="btn">მაღაზიაში დაბრუნება</a>
    </div>
  </div>
</Base>
<style>
  .layout { display: grid; grid-template-columns: 1fr 360px; gap: 28px; align-items: start; }
  .offer { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin: 0 0 24px; padding: 18px 20px; background: var(--forest-tint); border-radius: var(--r-md); }
  .offer :global(> div:first-child) { display: grid; gap: 4px; min-width: 0; }
  .offer :global(b) { font: 600 19px/1.25 var(--display); }
  .offer :global(s) { color: var(--muted); font-weight: 500; }
  .offer { border: 1.5px solid var(--forest); }
  .offer :global(.ob) { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .lines { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 12px; }
  .lines > :global(li) { display: grid; grid-template-columns: 76px 1fr auto; gap: 16px; align-items: center; padding: 14px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); }
  .lines :global(li > img) { width: 76px; aspect-ratio: 3/4; object-fit: contain; background: var(--surface-2); border-radius: 8px; }
  .lines :global(.t) { font-weight: 600; }
  .lines :global(.parts) { margin: 4px 0 0; padding-left: 18px; list-style: disc; font-size: 14px; color: var(--muted); }
  .lines :global(.q) { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; }
  .lines :global(.q button) { width: 32px; height: 32px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); font-weight: 600; cursor: pointer; }
  .lines :global(.q button:hover) { border-color: var(--forest); color: var(--forest); }
  .lines :global(.rm) { border: 0; background: none; text-decoration: underline; color: var(--muted); font-size: 13px; padding: 0; margin-top: 8px; cursor: pointer; }
  .lines :global(.e) { color: var(--terracotta); font-weight: 600; font-size: 14px; }
  .form { padding: 24px; display: grid; gap: 14px; }
  .form h2, .sum h2 { font-size: 22px; }
  .two { display: grid; grid-template-columns: 1fr 1.6fr; gap: 12px; }
  .hp { position: absolute; left: -9999px; }
  .banks { border: 0; padding: 0; margin: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .banks legend { font-weight: 600; margin-bottom: 8px; }
  .banks input { accent-color: var(--forest); }
  .err { color: var(--terracotta); font-weight: 600; margin: 0; min-height: 1em; }
  .sum { padding: 24px; position: sticky; top: 96px; }
  .r { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .tot { font: 600 22px var(--display); border: 0; }
  .prog { margin-top: 10px; padding: 14px; background: var(--surface-2); border-radius: var(--r-sm); }
  .pm { margin: 0 0 10px; font-size: 14px; font-weight: 500; }
  .bar { position: relative; height: 8px; background: #fff; border-radius: 99px; overflow: visible; }
  .bar span { position: absolute; inset: 0 auto 0 0; background: var(--forest); border-radius: 99px; transition: width .35s var(--ease); }
  .bar i { position: absolute; top: -3px; width: 2px; height: 14px; background: var(--muted); opacity: .5; }
  .ms { display: flex; justify-content: space-between; margin-top: 8px; font-size: 12px; color: var(--muted); }
  .ms .ok { color: var(--forest); font-weight: 600; }
  .ms span:only-child { margin-left: auto; }
  .small { font-size: 13px; }
  .link { color: var(--forest); font-weight: 600; }
  .empty, .done { padding: 28px; display: grid; gap: 12px; justify-items: start; max-width: 720px; }
  .done h2 { font-size: clamp(24px, 4vw, 34px); }
  .bank { display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; margin: 0; padding: 16px; background: var(--forest-tint); border-radius: var(--r-sm); }
  .bank dt { font-weight: 600; } .bank dd { margin: 0; word-break: break-all; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } .sum { position: static; order: -1; } .two { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .bar span { transition: none; } }
</style>
<script>
  import { read, write, clear } from '../lib/cart';
  import { computeTotals, bundleOffer, applyBundle, FREE_FROM, posterCount } from '../lib/pricing';
  import { SETTINGS, BUNDLES } from '../data/catalog';
  const $ = (id: string) => document.getElementById(id)!;
  const m = (n: number) => `${Number.isInteger(n) ? n : n.toFixed(2)} ₾`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function render() {
    if (!$('done').hidden) return;
    const lines = read();
    const t = computeTotals(lines);
    $('empty').hidden = lines.length > 0; $('full').hidden = !lines.length;
    $('lines').innerHTML = t.lines.map((l, i) => `<li>
      ${l.image ? `<img src="${esc(l.image)}" alt="">` : '<span></span>'}
      <div><div class="t">${esc(l.title)}</div>
        ${l.parts ? `<ul class="parts">${l.parts.map((p) => `<li>${esc(p)}</li>`).join('')}</ul>` : ''}
        ${l.type === 'product' ? `<div class="q"><button type="button" data-d="${i}" data-v="-1" aria-label="ნაკლები">−</button><b>${l.qty}</b><button type="button" data-d="${i}" data-v="1" aria-label="მეტი">+</button></div>` : ''}
        ${l.error ? `<div class="e">${esc(l.error)}</div>` : ''}
        <div><button type="button" class="rm" data-rm="${i}">წაშლა</button></div></div>
      <b>${m(l.total)}</b></li>`).join('');
    $('sub').textContent = m(t.subtotal);
    $('ship').textContent = t.shipping ? m(t.shipping) : 'უფასო';
    $('tot').textContent = m(t.total);
    const n = posterCount(t.lines), left = FREE_FROM - n;
    $('tip').textContent = '';
    // პროგრესი: 3 პოსტერი → უფასო მიწოდება, 4 პოსტერი (ნაკრებად) → საჩუქარი
    const gb = BUNDLES.find((b) => b.gift), giftOn = SETTINGS.gifts.some((g) => g.active && g.stock > 0);
    const goal = gb && giftOn ? gb.size : FREE_FROM;
    const hasGift = t.lines.some((l) => l.type === 'bundle' && !l.error && (l.raw as any).gift);
    $('prog').hidden = !n || !FREE_FROM;
    ($('pbar') as HTMLElement).style.width = `${Math.min(100, (n / goal) * 100)}%`;
    ($('prog').querySelector('i') as HTMLElement).style.left = `${(FREE_FROM / goal) * 100}%`;
    $('m4').hidden = goal === FREE_FROM;
    $('m3').classList.toggle('ok', n >= FREE_FROM); $('m4').classList.toggle('ok', hasGift);
    $('pm').textContent = left > 0
      ? `კიდევ ${left} პოსტერი — და მიწოდება უფასო იქნება.`
      : goal > n ? `მიწოდება უფასოა ✓ კიდევ ${goal - n} პოსტერი და ${goal}-პოსტერიან ნაკრებს საჩუქარიც მოჰყვება.`
      : hasGift || goal === FREE_FROM ? 'მიწოდება უფასოა ✓' + (hasGift ? ' საჩუქარი დამატებულია ✓' : '')
      : 'მიწოდება უფასოა ✓ აქციე პოსტერები ნაკრებად და საჩუქარიც მიიღე.';
    // ნაკრების შეთავაზება: ცალკე პოსტერები ნაკრებად უფრო იაფია
    const o = bundleOffer(lines), box = $('offer');
    box.hidden = !o;
    if (o) {
      const gifts = SETTINGS.gifts.filter((g) => g.active && g.stock > 0);
      box.innerHTML = `<div><span class="eyebrow">ნაკრებად უფრო ხელსაყრელია</span>
        <b>${o.size} პოსტერი ნაკრებად: <s>${m(o.before)}</s> → ${m(o.after)}</b>
        <span class="small">დაზოგე ${m(o.save)}${o.freeShipping ? ' · მიწოდება უფასოა' : ''}${o.gift && gifts.length ? ' · საჩუქრად ' + esc(gifts[0].name) : ''}</span>
        <span class="muted small">${o.items.map((i) => esc(i.title)).join(' · ')}</span></div>
        <div class="ob">${o.gift && gifts.length > 1 ? `<span class="small">აირჩიე საჩუქარი:</span>${gifts.map((g) => `<button type="button" class="btn sm" data-ob="${esc(g.id)}">${esc(g.name)}</button>`).join('')}`
          : `<button type="button" class="btn" data-ob="${o.gift && gifts[0] ? esc(gifts[0].id) : ''}">ნაკრებად ქცევა</button>`}</div>`;
      box.dataset.size = String(o.size); box.dataset.items = o.items.map((i) => i.slug).join(',');
    }
    ($('submit') as HTMLButtonElement).disabled = !t.ok;
  }
  $('offer').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-ob]'); if (!b) return;
    const box = $('offer');
    write(applyBundle(read(), +box.dataset.size!, box.dataset.items!.split(','), b.dataset.ob || undefined));
    window.dispatchEvent(new CustomEvent('toast', { detail: 'ნაკრებად გადაკეთდა ✓' }));
    render();
  });
  $('lines').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    const lines = read();
    if (b.dataset.rm) lines.splice(+b.dataset.rm, 1);
    else if (b.dataset.d) { const l = lines[+b.dataset.d] as any; l.qty = Math.max(1, Math.min(20, l.qty + +b.dataset.v!)); }
    write(lines); render();
  });
  $('form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    const btn = $('submit') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'იგზავნება…'; $('err').textContent = '';
    try {
      const res = await fetch('/api/order', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        lines: read(), bank: f.get('bank'), website: f.get('website'),
        customer: { name: f.get('name'), phone: f.get('phone'), city: f.get('city'), address: f.get('address'), notes: f.get('notes') } }) });
      const d = await res.json();
      if (!res.ok) throw new Error(d.error || 'შეკვეთა ვერ გაიგზავნა');
      $('full').hidden = true; $('done').hidden = false;
      clear(); $('h').textContent = 'შეკვეთა მიღებულია';
      $('ref').textContent = d.ref; $('d-total').textContent = m(d.total);
      $('d-bank').textContent = d.bank.name; $('d-recv').textContent = d.bank.receiver; $('d-iban').textContent = d.bank.iban;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      $('err').textContent = (err as Error).message || 'კავშირის შეცდომა, სცადე თავიდან';
      btn.disabled = false; btn.textContent = 'შეკვეთის გაფორმება';
    }
  });
  $('copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText($('d-iban').textContent!); window.dispatchEvent(new CustomEvent('toast', { detail: 'IBAN დაკოპირდა ✓' })); } catch {}
  });
  window.addEventListener('cart', render);
  render();
</script>
