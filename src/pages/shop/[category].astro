---
// კატეგორიის გვერდი: საკუთარი H1, შესავალი და პროდუქტები (ფასი/მარაგი catalog-იდან). /shop?category=x ძველი ბმულებიც მუშაობს.
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, CATEGORIES, BUNDLES, SETTINGS } from '../../data/catalog';
import { CATEGORY_PAGES } from '../../data/category-pages';
import { breadcrumbs, productUrl, SITE } from '../../lib/seo';

export function getStaticPaths() {
  return CATEGORIES.filter((c) => PRODUCTS.some((p) => p.categories.includes(c.id))).map((c) => ({ params: { category: c.id }, props: { id: c.id, name: c.name } }));
}
const { id, name } = Astro.props as { id: keyof typeof CATEGORY_PAGES; name: string };
const cp = CATEGORY_PAGES[id];
const items = PRODUCTS.filter((p) => p.categories.includes(id));
const prices = items.map((p) => p.price), lo = Math.min(...prices), hi = Math.max(...prices);
const priceTxt = lo === hi ? `${lo} ₾` : `${lo}–${hi} ₾`;
const others = CATEGORIES.filter((c) => c.id !== id && PRODUCTS.some((p) => p.categories.includes(c.id)));
const ld = [
  breadcrumbs([{ name: 'მთავარი', url: '/' }, { name: 'პოსტერები', url: '/shop' }, { name, url: `/shop/${id}` }]),
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: cp.h1, url: `${SITE}/shop/${id}`, inLanguage: 'ka',
    mainEntity: { '@type': 'ItemList', numberOfItems: items.length, itemListElement: items.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: productUrl(p), name: p.title })) } },
];
---
<Base title={cp.title} description={cp.description} jsonLd={ld}>
  <div class="container page-head">
    <nav class="crumbs" aria-label="ნავიგაცია"><a href="/">მთავარი</a> / <a href="/shop">პოსტერები</a> / <span>{name}</span></nav>
    <h1>{cp.h1}</h1>
    <p class="lead">{cp.intro}</p>
    <ul class="facts">
      <li><b>{items.length}</b> პოსტერი</li>
      <li><b>{priceTxt}</b> ერთი</li>
      <li><b>{SETTINGS.product.size}</b></li>
      <li>{SETTINGS.freeShippingFrom}+ პოსტერზე <b>უფასო მიწოდება</b></li>
    </ul>
  </div>
  <section class="container">
    <div class="grid">{items.map((p, i) => <ProductCard product={p} eager={i < 4} />)}</div>
  </section>
  <section class="container more">
    <div class="gift">
      <h2>ვისთვის არის კარგი საჩუქარი</h2>
      <p>{cp.giftFor}</p>
      <p>რამდენიმე პოსტერი ნაკრებად უფრო ხელსაყრელია: {BUNDLES.map((b) => `${b.size} — ${b.price} ₾`).join(', ')}. <a href="/#bundle-builder">ააწყვე ნაკრები →</a></p>
      <p><a href="/#gift-finder">ვერ ირჩევ? გაიარე 4-კითხვიანი საჩუქრის ქვიზი →</a></p>
    </div>
    <nav class="cats" aria-label="სხვა კატეგორიები">
      <h2>სხვა კატეგორიები</h2>
      <div>{others.map((c) => <a class="chip" href={`/shop/${c.id}`}>{c.name}</a>)}<a class="chip" href="/shop">ყველა პოსტერი</a></div>
    </nav>
  </section>
</Base>
<style>
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 14px; } .crumbs a { color: inherit; text-decoration: none; } .crumbs a:hover { color: var(--forest); }
  h1 { font-size: clamp(28px, 4vw, 44px); max-width: 22ch; }
  .lead { max-width: 64ch; color: var(--muted); font-size: 17px; margin: 14px 0 18px; }
  .facts { list-style: none; padding: 0; margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 8px; }
  .facts li { padding: 6px 12px; border-radius: 999px; background: var(--forest-tint); color: var(--forest); font-size: 14px; }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .more { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; margin-top: clamp(40px, 6vw, 72px); }
  .gift h2, .cats h2 { font-size: 22px; margin: 0 0 10px; }
  .gift p { margin: 0 0 10px; max-width: 62ch; } .gift a { color: var(--forest); font-weight: 600; }
  .cats div { display: flex; flex-wrap: wrap; gap: 8px; } .cats .chip { text-decoration: none; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } }
  @media (max-width: 760px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .more { grid-template-columns: 1fr; } }
</style>
