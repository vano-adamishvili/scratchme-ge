---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, categoryById, inStock, BUNDLES, SETTINGS } from '../../data/catalog';
import type { Product } from '../../data/catalog';
import { CATEGORY_PAGES } from '../../data/category-pages';
import { productLd, breadcrumbs, clip } from '../../lib/seo';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const ok = inStock(p);
const related = PRODUCTS.filter((x) => x.slug !== p.slug && x.categories.some((c) => p.categories.includes(c))).slice(0, 4);
// SEO: ადმინიდან შეყვანილი ტექსტი, ან ავტომატური — რეალური ფასით, ზომით და მიწოდებით
const seoTitle = p.seoTitle || `${p.title} — გადასაფხეკი პოსტერი`;
const desc = p.seoDescription || clip(`${p.title}: გადასაფხეკი პოსტერი ${SETTINGS.product.size}, ${p.price} ₾. ${p.subtitle ? p.subtitle.replace(/[.!]*$/, '.') + ' ' : ''}${p.description}`, 150) ;
const descFull = `${desc} მიწოდება მთელ საქართველოში, ${SETTINGS.freeShippingFrom}+ პოსტერზე უფასოდ.`;
const altFor = (label?: string) => p.title + ' — გადასაფხეკი პოსტერი' + (label ? ', ' + label.toLowerCase() : '');
const mainCat = p.categories[0];
const catName = categoryById(mainCat)?.name ?? 'პოსტერები';
// „ვისთვის არის კარგი საჩუქარი“: პროდუქტის საკუთარი ტექსტი (ადმინი) ან მისი მთავარი კატეგორიის ტექსტი
const giftFor = p.giftFor || CATEGORY_PAGES[mainCat as keyof typeof CATEGORY_PAGES]?.giftFor;
const verb = ({ travel: 'ეწვიე ადგილს', watch: 'უყურე', anime: 'უყურე', read: 'წაიკითხე', couples: 'გააკეთეთ ერთად', challenge: 'შეასრულე', kids: p.categories.includes('read') ? 'წაიკითხე' : 'უყურე' } as Record<string, string>)[mainCat] ?? 'გამოცადე';
const steps = [
  `აირჩიე უჯრა პოსტერზე`,
  `${verb}`,
  `მონეტით გადაფხიკე ვერცხლისფერი ფენა და აღმოაჩინე სურათი ქვემოთ`,
];
const b2 = BUNDLES[0];
const ld = [
  productLd(p, p.description.replace(/\s+/g, ' ').trim()),
  breadcrumbs([{ name: 'მთავარი', url: '/' }, { name: 'პოსტერები', url: '/shop' }, { name: catName, url: `/shop/${mainCat}` }, { name: p.title, url: `/product/${p.slug}` }]),
];
---
<Base title={seoTitle} description={descFull.length <= 160 ? descFull : desc} image={p.ogImage || p.images[0]?.url} imageAlt={`${p.title} — გადასაფხეკი პოსტერი`} type="product" jsonLd={ld}>
  <div class="container wrap" style={`--a:${p.accent}`}>
    <nav class="crumbs eyebrow" aria-label="ნავიგაცია"><a href="/">მთავარი</a> / <a href="/shop">პოსტერები</a> / <a href={`/shop/${mainCat}`}>{catName}</a> / <span>{p.title}</span></nav>
    <div class="grid">
      <div class="gallery">
        <div class="main card">
          <div class="track" id="track" tabindex="0" aria-label={`${p.title} — ფოტოები`} aria-roledescription="კარუსელი">
            {p.images.map((im, i) => (
              <div class="slide" aria-label={`${i + 1} / ${p.images.length}`}>
                <img src={im.url} alt={altFor(im.label)} width="800" height="1125" data-zoom={im.url} loading={i ? 'lazy' : 'eager'} decoding="async" />
              </div>
            ))}
          </div>
          {p.images.length > 1 && (
            <>
              <button type="button" class="nav prev" id="g-prev" aria-label="წინა ფოტო" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
              <button type="button" class="nav next" id="g-next" aria-label="შემდეგი ფოტო"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
              <div class="dots" aria-hidden="true">{p.images.map((_, i) => <span class:list={[{ on: i === 0 }]} />)}</div>
            </>
          )}
        </div>
        {p.images.length > 1 && (
          <div class="thumbs">
            {p.images.map((im, i) => (
              <button type="button" class:list={['th', { on: i === 0 }]} data-i={i} aria-label={im.label || `ფოტო ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>
                <img src={im.thumb} alt="" loading="lazy" width="120" height="160" />
                {im.label && <span>{im.label}</span>}
              </button>
            ))}
          </div>
        )}
      </div>
      <div class="info">
        <div class="tags">
          {p.badge && <span class="badge">{p.badge}</span>}
          {p.categories.map((c) => <a class="eyebrow" href={`/shop/${c}`}>{categoryById(c)?.name}</a>)}
        </div>
        <h1>{p.title}</h1>
        {p.titleEn && <p class="en eyebrow">{p.titleEn}</p>}
        {p.subtitle && <p class="sub">{p.subtitle}</p>}
        <p class="pp">{p.price} ₾</p>
        {ok ? (
          <div class="buy">
            <label class="qty"><span class="sr-only">რაოდენობა</span><input id="qty" type="number" min="1" max="20" value="1" inputmode="numeric" /></label>
            <button class="btn" data-add={p.slug} data-qty="#qty">კალათაში დამატება</button>
          </div>
        ) : <p class="out">მარაგი დროებით ამოიწურა</p>}
        {ok && <a class="bundle" href={`/?add=${p.slug}#bundle-builder`}>ან დაამატე ნაკრებში — {b2.size} პოსტერი {b2.price} ₾-დან →</a>}
        <ul class="feats">{p.features.map((f) => <li>{f}</li>)}</ul>
        <div class="desc">{p.description.split(/\n\s*\n/).map((para) => <p>{para}</p>)}</div>
        <dl class="spec">
          <div><dt>ზომა</dt><dd>{SETTINGS.product.size}</dd></div>
          <div><dt>შეფუთვა</dt><dd>{SETTINGS.product.packaging}</dd></div>
          <div><dt>ჩარჩო</dt><dd>{SETTINGS.product.frame}</dd></div>
          <div><dt>მიწოდება</dt><dd>თბილისში 2 სამუშაო დღე, რეგიონებში 3+ · {SETTINGS.shippingFee} ₾, {SETTINGS.freeShippingFrom}+ პოსტერზე უფასოდ</dd></div>
        </dl>
        <section class="extra" aria-labelledby="how-h">
          <h2 id="how-h">როგორ გამოიყენება</h2>
          <ol>{steps.map((s) => <li>{s}</li>)}</ol>
          <p>პოსტერი ლამაზად გამოიყურება ყოველ ეტაპზე — დაფარულიც, ნახევრად გადაფხეკილიც და ბოლომდე შევსებულიც. <a href="/#how-it-works">ნახე, როგორ მუშაობს →</a></p>
        </section>
        {giftFor && (
          <section class="extra" aria-labelledby="gift-h">
            <h2 id="gift-h">ვისთვის არის კარგი საჩუქარი</h2>
            <p>{giftFor}</p>
            <p><a href={`/shop/${mainCat}`}>სხვა პოსტერები: {catName.toLowerCase()} →</a> · <a href="/secret-santa">სეკრეტ სანტას საჩუქრები →</a></p>
          </section>
        )}
      </div>
    </div>
    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>შეიძლება მოგეწონოს</h2></div>
        <div class="rel">{related.map((r) => <ProductCard product={r} />)}</div>
      </section>
    )}
  </div>
</Base>
<style>
  .wrap { padding-top: 24px; }
  .crumbs { margin-bottom: 20px; font-size: 14px; color: var(--muted); } .crumbs a { text-decoration: none; color: inherit; } .crumbs a:hover { color: var(--forest); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: start; }
  .main { padding: clamp(16px, 3vw, 36px); background: var(--surface-2); border: 0; box-shadow: none; border-radius: var(--r-lg); }
  .main { position: relative; }
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; overscroll-behavior-x: contain; border-radius: 4px; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--forest); outline-offset: 4px; }
  .slide { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; }
  .slide img { display: block; width: 100%; height: auto; border-radius: 4px; }
  .main { box-shadow: none; }
  .nav { position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255,255,255,.95); color: var(--forest); box-shadow: var(--shadow); cursor: pointer; transition: opacity .2s ease, background .15s ease; }
  .nav:hover { background: #fff; }
  .nav:disabled { opacity: 0; pointer-events: none; }
  .nav svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .prev { left: 6px; } .next { right: 6px; }
  .dots { position: absolute; left: 0; right: 0; bottom: 6px; display: flex; justify-content: center; gap: 6px; }
  .dots span { width: 7px; height: 7px; border-radius: 50%; background: rgba(37,42,39,.25); transition: background .2s ease, width .2s ease; }
  .dots span.on { width: 18px; border-radius: 4px; background: var(--forest); }
  @media (prefers-reduced-motion: reduce) { .track { scroll-behavior: auto; } }
  .thumbs { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
  .th { display: grid; gap: 4px; width: 110px; overflow-wrap: anywhere; padding: 6px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface); font-size: 11px; line-height: 1.2; text-align: center; cursor: pointer; transition: border-color .15s ease; }
  .th:hover { border-color: #C8CFC9; }
  .th.on { border-color: var(--forest); box-shadow: 0 0 0 1px var(--forest); }
  .th img { aspect-ratio: 3/4; object-fit: contain; width: 100%; }
  .info { position: sticky; top: 96px; }
  .tags { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; } .tags a { text-decoration: none; }
  h1 { font-size: clamp(30px, 3.6vw, 44px); margin: 12px 0 4px; }
  .en { color: var(--muted); }
  .sub { font-size: 18px; font-weight: 500; margin: 8px 0; }
  .pp { font: 600 30px var(--display); margin: 14px 0 18px; color: var(--text); }
  .buy { display: flex; gap: 10px; }
  .qty input { width: 76px; height: 50px; border: 1px solid #CDD2CC; border-radius: var(--r-sm); text-align: center; font-weight: 600; font-size: 17px; background: var(--surface); }
  .buy .btn { flex: 1; }
  .bundle { display: inline-block; margin-top: 14px; font-weight: 600; color: var(--forest); text-underline-offset: 4px; }
  .out { font-weight: 600; color: var(--terracotta); }
  .feats { list-style: none; padding: 0; margin: 24px 0 18px; display: flex; gap: 8px; flex-wrap: wrap; }
  .feats li { padding: 6px 12px; background: var(--forest-tint); color: var(--forest); border-radius: 999px; font-size: 14px; }
  .desc p { margin: 0 0 12px; font-size: 16.5px; }
  .spec { margin: 22px 0 0; border-top: 1px solid var(--border); }
  .spec > div { display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--border); font-size: 15px; }
  .spec dt { font-weight: 600; color: var(--muted); } .spec dd { margin: 0; }
  .extra { margin-top: 26px; }
  .extra h2 { font-size: 20px; margin: 0 0 8px; }
  .extra ol { margin: 0 0 8px; padding-left: 20px; } .extra li { margin: 2px 0; }
  .extra p { margin: 0 0 8px; color: var(--text); } .extra a { color: var(--forest); font-weight: 600; }
  .rel { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  @media (max-width: 980px) { .rel { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .info { position: static; } .rel { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .spec > div { grid-template-columns: 90px 1fr; } }
</style>
<script>
  // გალერეა: ისრები, ტელეფონზე გადასქროლვა (scroll-snap), მინიატურები, კლავიატურის ისრები
  const track = document.getElementById('track');
  if (track) {
    const n = track.children.length;
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.th')];
    const dots = [...document.querySelectorAll<HTMLElement>('.dots span')];
    const prev = document.getElementById('g-prev') as HTMLButtonElement | null;
    const next = document.getElementById('g-next') as HTMLButtonElement | null;
    let cur = 0;
    const go = (i: number) => { i = Math.max(0, Math.min(n - 1, i)); track.scrollTo({ left: i * track.clientWidth }); };
    const sync = () => {
      const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      if (i === cur && prev?.disabled === (i === 0)) return;
      cur = i;
      thumbs.forEach((b, k) => { b.classList.toggle('on', k === i); b.toggleAttribute('aria-current', k === i); });
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
      if (prev) prev.disabled = i === 0; if (next) next.disabled = i === n - 1;
    };
    let raf = 0; track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); }, { passive: true });
    prev?.addEventListener('click', () => go(cur - 1));
    next?.addEventListener('click', () => go(cur + 1));
    thumbs.forEach((b) => b.addEventListener('click', () => go(+b.dataset.i!)));
    track.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); } else if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); } });
    window.addEventListener('resize', () => track.scrollTo({ left: cur * track.clientWidth, behavior: 'instant' as ScrollBehavior }));
    sync();
  }
</script>
