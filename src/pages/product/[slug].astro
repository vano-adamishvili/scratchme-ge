---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, categoryById, inStock, BUNDLES, SETTINGS } from '../../data/catalog';
import type { Product } from '../../data/catalog';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const ok = inStock(p);
const related = PRODUCTS.filter((x) => x.slug !== p.slug && x.categories.some((c) => p.categories.includes(c))).slice(0, 4);
const desc = (p.subtitle ? p.subtitle + ' — ' : '') + p.description.replace(/\s+/g, ' ').slice(0, 150);
const b2 = BUNDLES[0];
const ld = { '@context': 'https://schema.org', '@type': 'Product', name: p.title, alternateName: p.titleEn, image: p.images.map((i) => new URL(i.url, Astro.site).href), description: p.description, brand: { '@type': 'Brand', name: 'scratchme.ge' },
  offers: { '@type': 'Offer', price: p.price.toFixed(2), priceCurrency: 'GEL', availability: ok ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock', url: `https://scratchme.ge/product/${p.slug}` } };
---
<Base title={p.title} description={desc} image={p.images[0]?.url} type="product" jsonLd={ld}>
  <div class="container wrap" style={`--a:${p.accent}`}>
    <nav class="crumbs eyebrow" aria-label="ნავიგაცია"><a href="/">მთავარი</a> / <a href="/shop">პოსტერები</a> / <span>{p.title}</span></nav>
    <div class="grid">
      <div class="gallery">
        <div class="main card"><img id="pimg" src={p.images[0]?.url} alt={p.title} width="800" height="1066" data-zoom={p.images[0]?.url} /></div>
        {p.images.length > 1 && (
          <div class="thumbs">
            {p.images.map((im, i) => (
              <button type="button" class:list={['th', { on: i === 0 }]} data-src={im.url} aria-label={im.label || `ფოტო ${i + 1}`}>
                <img src={im.thumb} alt="" loading="lazy" width="120" height="160" />
                {im.label && <span>{im.label}</span>}
              </button>
            ))}
          </div>
        )}
      </div>
      <div class="info">
        <div class="tags">
          {p.badge && <span class="badge">{p.badge}</span>}
          {p.categories.map((c) => <a class="eyebrow" href={`/shop?category=${c}`}>{categoryById(c)?.name}</a>)}
        </div>
        <h1>{p.title}</h1>
        {p.titleEn && <p class="en eyebrow">{p.titleEn}</p>}
        {p.subtitle && <p class="sub">{p.subtitle}</p>}
        <p class="pp">{p.price} ₾</p>
        {ok ? (
          <div class="buy">
            <label class="qty"><span class="sr-only">რაოდენობა</span><input id="qty" type="number" min="1" max="20" value="1" inputmode="numeric" /></label>
            <button class="btn" data-add={p.slug} data-qty="#qty">კალათაში დამატება</button>
          </div>
        ) : <p class="out">მარაგი დროებით ამოიწურა</p>}
        {ok && <a class="bundle" href={`/?add=${p.slug}#bundle-builder`}>ან დაამატე ნაკრებში — {b2.size} პოსტერი {b2.price} ₾-დან →</a>}
        <ul class="feats">{p.features.map((f) => <li>{f}</li>)}</ul>
        <div class="desc">{p.description.split(/\n\s*\n/).map((para) => <p>{para}</p>)}</div>
        <dl class="spec">
          <div><dt>ზომა</dt><dd>{SETTINGS.product.size}</dd></div>
          <div><dt>შეფუთვა</dt><dd>{SETTINGS.product.packaging}</dd></div>
          <div><dt>ჩარჩო</dt><dd>{SETTINGS.product.frame}</dd></div>
          <div><dt>მიწოდება</dt><dd>თბილისში 2 სამუშაო დღე, რეგიონებში 3+ · {SETTINGS.shippingFee} ₾, {SETTINGS.freeShippingFrom}+ პოსტერზე უფასოდ</dd></div>
        </dl>
      </div>
    </div>
    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>შეიძლება მოგეწონოს</h2></div>
        <div class="rel">{related.map((r) => <ProductCard product={r} />)}</div>
      </section>
    )}
  </div>
</Base>
<style>
  .wrap { padding-top: 24px; }
  .crumbs { margin-bottom: 20px; font-size: 14px; color: var(--muted); } .crumbs a { text-decoration: none; color: inherit; } .crumbs a:hover { color: var(--forest); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: start; }
  .main { padding: clamp(16px, 3vw, 36px); background: var(--surface-2); border: 0; box-shadow: none; border-radius: var(--r-lg); }
  .main img { display: block; width: 100%; height: auto; border-radius: 4px; box-shadow: var(--shadow); }
  .thumbs { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
  .th { display: grid; gap: 4px; width: 84px; padding: 6px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface); font-size: 11px; line-height: 1.2; text-align: center; cursor: pointer; transition: border-color .15s ease; }
  .th:hover { border-color: #C8CFC9; }
  .th.on { border-color: var(--forest); box-shadow: 0 0 0 1px var(--forest); }
  .th img { aspect-ratio: 3/4; object-fit: contain; width: 100%; }
  .info { position: sticky; top: 96px; }
  .tags { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; } .tags a { text-decoration: none; }
  h1 { font-size: clamp(30px, 3.6vw, 44px); margin: 12px 0 4px; }
  .en { color: var(--muted); }
  .sub { font-size: 18px; font-weight: 500; margin: 8px 0; }
  .pp { font: 600 30px var(--display); margin: 14px 0 18px; color: var(--text); }
  .buy { display: flex; gap: 10px; }
  .qty input { width: 76px; height: 50px; border: 1px solid #CDD2CC; border-radius: var(--r-sm); text-align: center; font-weight: 600; font-size: 17px; background: var(--surface); }
  .buy .btn { flex: 1; }
  .bundle { display: inline-block; margin-top: 14px; font-weight: 600; color: var(--forest); text-underline-offset: 4px; }
  .out { font-weight: 600; color: var(--terracotta); }
  .feats { list-style: none; padding: 0; margin: 24px 0 18px; display: flex; gap: 8px; flex-wrap: wrap; }
  .feats li { padding: 6px 12px; background: var(--forest-tint); color: var(--forest); border-radius: 999px; font-size: 14px; }
  .desc p { margin: 0 0 12px; font-size: 16.5px; }
  .spec { margin: 22px 0 0; border-top: 1px solid var(--border); }
  .spec > div { display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--border); font-size: 15px; }
  .spec dt { font-weight: 600; color: var(--muted); } .spec dd { margin: 0; }
  .rel { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  @media (max-width: 980px) { .rel { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .info { position: static; } .rel { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .spec > div { grid-template-columns: 90px 1fr; } }
</style>
<script>
  const img = document.getElementById('pimg') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.th').forEach((b) => b.addEventListener('click', () => {
    if (!img) return; img.src = b.dataset.src!; img.dataset.zoom = b.dataset.src!;
    document.querySelectorAll('.th').forEach((x) => x.classList.toggle('on', x === b));
  }));
</script>
