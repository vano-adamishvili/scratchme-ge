---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, categoryById, inStock, BUNDLES, SETTINGS } from '../../data/catalog';
import type { Product } from '../../data/catalog';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const ok = inStock(p);
const related = PRODUCTS.filter((x) => x.slug !== p.slug && x.categories.some((c) => p.categories.includes(c))).slice(0, 4);
const desc = (p.subtitle ? p.subtitle + ' — ' : '') + p.description.replace(/\s+/g, ' ').slice(0, 150);
const b2 = BUNDLES[0];
const ld = { '@context': 'https://schema.org', '@type': 'Product', name: p.title, alternateName: p.titleEn, image: p.images.map((i) => i.url), description: p.description, brand: { '@type': 'Brand', name: 'scratchme.ge' },
  offers: { '@type': 'Offer', price: p.price.toFixed(2), priceCurrency: 'GEL', availability: ok ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock', url: `https://scratchme.ge/product/${p.slug}` } };
---
<Base title={p.title} description={desc} image={p.images[0]?.url} type="product" jsonLd={ld}>
  <div class="container wrap" style={`--a:${p.accent}`}>
    <nav class="crumbs eyebrow" aria-label="ნავიგაცია"><a href="/">მთავარი</a> / <a href="/shop">პოსტერები</a> / <span>{p.title}</span></nav>
    <div class="grid">
      <div class="gallery">
        <div class="main card"><img id="pimg" src={p.images[0]?.url} alt={p.title} width="800" height="1066" data-zoom={p.images[0]?.url} /></div>
        {p.images.length > 1 && (
          <div class="thumbs">
            {p.images.map((im, i) => (
              <button type="button" class:list={['th', { on: i === 0 }]} data-src={im.url} aria-label={im.label || `ფოტო ${i + 1}`}>
                <img src={im.url} alt="" loading="lazy" width="120" height="160" />
                {im.label && <span>{im.label}</span>}
              </button>
            ))}
          </div>
        )}
      </div>
      <div class="info">
        <div class="tags">
          {p.badge && <span class="badge" style="background:var(--a)">{p.badge}</span>}
          {p.categories.map((c) => <a class="eyebrow" href={`/shop?category=${c}`}>{categoryById(c)?.name}</a>)}
        </div>
        <h1>{p.title}</h1>
        {p.titleEn && <p class="en eyebrow">{p.titleEn}</p>}
        {p.subtitle && <p class="sub">{p.subtitle}</p>}
        <p class="pp">{p.price.toFixed(2)} ₾</p>
        {ok ? (
          <div class="buy">
            <label class="qty"><span class="sr-only">რაოდენობა</span><input id="qty" type="number" min="1" max="20" value="1" inputmode="numeric" /></label>
            <button class="btn coral" data-add={p.slug} data-qty="#qty">კალათაში დამატება</button>
          </div>
        ) : <p class="out">მარაგი დროებით ამოიწურა</p>}
        {ok && <a class="bundle" href={`/?add=${p.slug}#bundle-builder`}>ან დაამატე ნაკრებში — {b2.size} პოსტერი {b2.price} ₾-დან →</a>}
        <ul class="feats">{p.features.map((f) => <li>✦ {f}</li>)}</ul>
        <div class="desc">{p.description.split(/\n\s*\n/).map((para) => <p>{para}</p>)}</div>
        <p class="ship muted">🚚 მიტანა მთელ საქართველოში · {SETTINGS.shippingFee.toFixed(2)} ₾, 3+ პოსტერიან ნაკრებზე უფასოდ</p>
      </div>
    </div>
    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>შეიძლება მოგეწონოს</h2></div>
        <div class="rel">{related.map((r) => <ProductCard product={r} />)}</div>
      </section>
    )}
  </div>
</Base>
<style>
  .wrap { padding-top: 20px; }
  .crumbs { margin-bottom: 18px; } .crumbs a { text-decoration: none; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 4vw, 56px); align-items: start; }
  .main { background: color-mix(in srgb, var(--a) 22%, var(--paper)); }
  .main img { display: block; width: 100%; height: auto; }
  .thumbs { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
  .th { display: grid; gap: 4px; width: 92px; padding: 4px; border: 1.5px solid var(--line); background: #fff; font-size: 11px; line-height: 1.2; text-align: center; }
  .th.on { border-color: var(--ink); box-shadow: 3px 3px 0 var(--a); }
  .th img { aspect-ratio: 3/4; object-fit: contain; width: 100%; }
  .info { position: sticky; top: 90px; }
  .tags { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; } .tags a { text-decoration: none; }
  h1 { font-size: clamp(32px, 4.6vw, 54px); margin: 14px 0 6px; }
  .sub { font-size: 18px; font-weight: 600; margin: 8px 0; }
  .pp { font: 700 34px var(--display); letter-spacing: -.03em; margin: 12px 0; }
  .buy { display: flex; gap: 10px; }
  .qty input { width: 76px; height: 48px; border: 1.5px solid var(--ink); text-align: center; font-weight: 700; font-size: 17px; background: #fff; }
  .buy .btn { flex: 1; }
  .bundle { display: inline-block; margin-top: 12px; font-weight: 700; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .out { font-weight: 700; color: var(--coral); }
  .feats { list-style: none; padding: 0; margin: 22px 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .feats li { padding: 6px 10px; background: #fff; border: 1px solid var(--ink); font-size: 14px; }
  .desc p { margin: 0 0 12px; font-size: 16.5px; }
  .rel { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .info { position: static; } .rel { grid-template-columns: 1fr 1fr; gap: 12px; } }
</style>
<script>
  const img = document.getElementById('pimg') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.th').forEach((b) => b.addEventListener('click', () => {
    if (!img) return; img.src = b.dataset.src!; img.dataset.zoom = b.dataset.src!;
    document.querySelectorAll('.th').forEach((x) => x.classList.toggle('on', x === b));
  }));
</script>
