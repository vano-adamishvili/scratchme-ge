---
// სეკრეტ სანტას გვერდი: საკუთარი შინაარსი (ვისთვის, ბიუჯეტი მიწოდების ჩათვლით, ნაკრებები, FAQ) + რეალური პროდუქტები catalog-იდან.
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTS, CATEGORIES, BUNDLES, GIFTS, SETTINGS } from '../data/catalog';
import { breadcrumbs, productUrl, SITE } from '../lib/seo';

const fee = SETTINGS.shippingFee;
const free = SETTINGS.freeShippingFrom;
const prices = [...new Set(PRODUCTS.map((p) => p.price))].sort((a, b) => a - b);
const lo = prices[0], hi = prices[prices.length - 1];
const priceTxt = lo === hi ? `${lo}` : `${lo}–${hi}`;
const cheap = PRODUCTS.filter((p) => p.price === lo);
// ბიუჯეტის ღილაკები: პოსტერის ფასი + მიწოდება (ერთ პოსტერზე მიწოდება ფასიანია)
const budgets = prices.map((pr) => ({ max: pr + fee, label: `${pr + fee} ₾-მდე` }));
const cats = CATEGORIES.filter((c) => PRODUCTS.some((p) => p.categories.includes(c.id)));
const gift = GIFTS[0]?.name;
const bundles = BUNDLES.map((b) => ({ ...b, total: b.price + (b.freeShipping ? 0 : fee), per: Math.round((b.price / b.size) * 100) / 100 }));

const forWhom = [
  { t: 'კოლეგას', d: 'ოფისის სეკრეტ სანტაზე, როცა ადამიანს კარგად არ იცნობ: ფილმები, სერიალები და მოგზაურობა თითქმის ყველას აინტერესებს.', href: '/shop/watch', link: 'ფილმები და სერიალები' },
  { t: 'მეგობარს', d: 'ვინც სულ ახალ ადგილებს ეძებს ან წიგნს ხელიდან არ უშვებს — საჩუქარი, რომელიც თვეობით გამოადგება.', href: '/shop/travel', link: 'მოგზაურობა' },
  { t: 'მკითხველს', d: 'წასაკითხი სიები მოზრდილებისთვის და ბავშვებისთვის: წაიკითხე, გადაფხიკე, გაიზარდე.', href: '/shop/read', link: 'წიგნები' },
  { t: 'წყვილს', d: 'პაემნის იდეები ორისთვის — ყოველი გადაფხეკილი უჯრა ერთად გატარებული საღამოა.', href: '/shop/couples', link: 'წყვილებისთვის' },
  { t: 'ანიმეს მოყვარულს', d: 'ანიმე, Pixar და მულტფილმები — ფერადი პოსტერი ოთახისთვის და სია, რომ არაფერი გამორჩეს.', href: '/shop/anime', link: 'ანიმე და ანიმაცია' },
  { t: 'ბავშვს', d: 'ასაკის მიხედვით შერჩეული წიგნები და მულტფილმები — ყოველი უჯრა პატარა გამარჯვებაა.', href: '/shop/kids', link: 'ბავშვებისთვის' },
];

const faqs = [
  { q: 'რა ღირს სეკრეტ სანტას საჩუქარი ScratchMe-ზე?', a: `ერთი პოსტერი ${priceTxt} ₾ ღირს, მიწოდება — ${fee} ₾. ${free} ან მეტი პოსტერის შეკვეთისას მიწოდება უფასოა.` },
  { q: `როგორ ჩავეტიო ${lo + fee} ლარიან ბიუჯეტში?`, a: `${lo} ₾-იანი პოსტერი მიწოდებით ზუსტად ${lo + fee} ₾ გამოდის: ${cheap.map((p) => p.title).join(', ')}.` },
  { q: 'შემიძლია რამდენიმე პოსტერი ერთად შევუკვეთო, მაგალითად მთელი გუნდისთვის?', a: `კი, ნაკრებად უფრო ხელსაყრელია: ${bundles.map((b) => `${b.size} პოსტერი — ${b.price} ₾`).join(', ')}. ${free}+ პოსტერზე მიწოდება უფასოა${gift ? `, 4-პოსტერიან ნაკრებს კი საჩუქრად ${gift.toLowerCase()} მოჰყვება` : ''}. შეკვეთა ერთ მისამართზე იგზავნება.` },
  { q: 'რამდენ ხანში მომიტანენ შეკვეთას?', a: 'შეკვეთის დადასტურებიდან და გადახდიდან თბილისში 2 სამუშაო დღეში, რეგიონებში 3 და მეტ სამუშაო დღეში — დამოკიდებულია საკურიერო კომპანიაზე. სეკრეტ სანტას დღემდე ამ ვადის გათვალისწინებით შეუკვეთე.' },
  { q: 'როგორ არის შეფუთული? ჩანს თუ არა, რა არის შიგნით?', a: `${SETTINGS.product.packaging} შიგთავსი გარედან არ ჩანს.` },
  { q: 'რა ზომისაა პოსტერი და მოყვება თუ არა ჩარჩო?', a: `${SETTINGS.product.size}. ${SETTINGS.product.frame}` },
  { q: 'თუ საჩუქარი არ მოეწონა?', a: 'მიღებიდან 7 სამუშაო დღის განმავლობაში შეგიძლია დააბრუნო ან გაცვალო, თუ პოსტერი გადაუფხეკელი და დაუზიანებელია. დაბრუნების საკურიერო ხარჯს მყიდველი იხდის.' },
];

const title = `სეკრეტ სანტას საჩუქრები ${priceTxt} ლარად — ორიგინალური იდეები`;
const description = `სეკრეტ სანტას საჩუქრის იდეები: თემატური გადასაფხეკი პოსტერები ${priceTxt} ₾ (მიწოდება ${fee} ₾, ${free}+ პოსტერზე უფასო). ფილმები, წიგნები, მოგზაურობა, ანიმე. მიწოდება მთელ საქართველოში.`;
const ld = [
  breadcrumbs([{ name: 'მთავარი', url: '/' }, { name: 'სეკრეტ სანტა', url: '/secret-santa' }]),
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: `${SITE}/secret-santa`, inLanguage: 'ka', description,
    mainEntity: { '@type': 'ItemList', numberOfItems: PRODUCTS.length, itemListElement: PRODUCTS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: productUrl(p), name: p.title })) } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base fullTitle title={`${title} | ScratchMe`} description={description} jsonLd={ld}>
  <header class="container ss-head">
    <nav class="crumbs" aria-label="ნავიგაცია"><a href="/">მთავარი</a> / <span>სეკრეტ სანტა</span></nav>
    <span class="eyebrow">საახალწლო საჩუქრები</span>
    <h1>სეკრეტ სანტას საჩუქრები — ორიგინალური იდეები {priceTxt} ლარად</h1>
    <p class="lead">როცა არ იცი, რა აჩუქო კოლეგას ან მეგობარს, აჩუქე ისტორია, რომელსაც თვითონ შექმნის. გადასაფხეკ პოსტერზე ყოველი უჯრა ერთი ფილმი, წიგნი ან ადგილია: ნახავს, წაიკითხავს, ეწვევა — და მონეტით გადაფხეკს. საჩუქარი, რომელიც თვეობით რჩება კედელზე და არა უჯრაში.</p>
    <ul class="facts">
      <li><b>{priceTxt} ₾</b> ერთი პოსტერი</li>
      <li>მიწოდება <b>{fee} ₾</b> · {free}+ პოსტერზე <b>უფასო</b></li>
      <li><b>{SETTINGS.product.size}</b></li>
      <li>თბილისი <b>2</b> სამუშაო დღე · რეგიონები <b>3+</b></li>
    </ul>
    <div class="cta"><a href="#ss-products" class="btn">აირჩიე საჩუქარი</a><a href="/#gift-finder" class="btn ghost">გაიარე საჩუქრის ქვიზი</a></div>
  </header>

  <section class="container section ss-who" aria-labelledby="who-h">
    <h2 id="who-h">ვისთვის არის ეს საჩუქრები</h2>
    <div class="who">
      {forWhom.map((w) => (
        <article><h3>{w.t}</h3><p>{w.d}</p><a href={w.href}>{w.link} →</a></article>
      ))}
    </div>
  </section>

  <section id="ss-products" class="container section" aria-labelledby="pr-h" data-fee={fee}>
    <h2 id="pr-h">აირჩიე ბიუჯეტით და თემით</h2>
    <p class="muted">ბიუჯეტში მიწოდებაც ითვლება: ერთ პოსტერზე +{fee} ₾.</p>
    <div class="flt" role="group" aria-label="ბიუჯეტი">
      <button type="button" class="chip on" data-b="" aria-pressed="true">ნებისმიერი ბიუჯეტი</button>
      {budgets.map((b) => <button type="button" class="chip" data-b={b.max} aria-pressed="false">{b.label} (მიწოდებით)</button>)}
    </div>
    <div class="flt" role="group" aria-label="თემა">
      <button type="button" class="chip on" data-c="" aria-pressed="true">ყველა თემა</button>
      {cats.map((c) => <button type="button" class="chip" data-c={c.id} aria-pressed="false">{c.name}</button>)}
    </div>
    <p class="count muted" id="ss-count" aria-live="polite">{PRODUCTS.length} პოსტერი</p>
    <div class="grid" id="ss-grid">{PRODUCTS.map((p, i) => <ProductCard product={p} eager={i < 4} />)}</div>
    <p class="empty" id="ss-empty" hidden>ამ არჩევანით პოსტერი არ მოიძებნა — სცადე სხვა თემა ან ბიუჯეტი.</p>
  </section>

  <section class="container section ss-how" aria-labelledby="how-h">
    <div>
      <h2 id="how-h">როგორ მუშაობს გადასაფხეკი პოსტერი</h2>
      <ol>
        <li><b>აირჩიე</b> — თემა, რომელიც ადრესატს უყვარს.</li>
        <li><b>გადაფხიკე</b> — ნანახ ფილმს, წაკითხულ წიგნს ან მონახულებულ ადგილს მონეტით გადაფხეკს.</li>
        <li><b>შექმენი ისტორია</b> — ქვემოთ სურათი ჩნდება და პოსტერი თანდათან ივსება.</li>
      </ol>
      <a href="/#how-it-works">სცადე გადაფხეკა საიტზე →</a>
    </div>
    <div class="bund">
      <h2>რამდენიმე საჩუქარი ერთად</h2>
      <p class="muted">თუ რამდენიმე ადამიანს ყიდულობ, ნაკრები უფრო იაფია.</p>
      <ul>
        {bundles.map((b) => (
          <li>
            <a href={`/?bundle=${b.size}#catalog`}>
              <span><b>{b.size} პოსტერი</b> — {b.price} ₾</span>
              <span class="muted">{b.freeShipping ? 'უფასო მიწოდება' : `+ მიწოდება ${fee} ₾`}{b.gift && gift ? ` + ${gift.toLowerCase()}` : ''} · ერთი {b.per} ₾</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container section ss-faq" aria-labelledby="faq-h">
    <h2 id="faq-h">ხშირად დასმული კითხვები</h2>
    <div class="list">
      {faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>
    <p class="more">სხვა კითხვები: <a href="/delivery-returns">მიწოდება და დაბრუნება</a> · <a href="/contact">კონტაქტი</a> · <a href="/shop">ყველა პოსტერი</a></p>
  </section>
</Base>
<style>
  .ss-head { padding-top: 24px; }
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 16px; } .crumbs a { color: inherit; text-decoration: none; } .crumbs a:hover { color: var(--forest); }
  h1 { font-size: clamp(28px, 4.2vw, 48px); max-width: 20ch; margin: 8px 0 14px; }
  .lead { max-width: 64ch; font-size: 17px; color: var(--muted); margin: 0 0 18px; }
  .facts { list-style: none; padding: 0; margin: 0 0 22px; display: flex; flex-wrap: wrap; gap: 8px; }
  .facts li { padding: 7px 13px; border-radius: 999px; background: var(--forest-tint); color: var(--forest); font-size: 14px; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .who { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 18px; }
  .who article { padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); }
  .who h3 { margin: 0 0 6px; font-size: 18px; } .who p { margin: 0 0 10px; color: var(--muted); font-size: 15px; }
  .who a, .ss-how a, .more a { color: var(--forest); font-weight: 600; }
  .flt { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
  .count { margin: 16px 0 0; font-size: 14px; }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin-top: 14px; }
  .empty { padding: 20px; background: var(--surface-2); border-radius: var(--r-md); }
  .ss-how { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 64px); }
  .ss-how ol { padding-left: 20px; margin: 12px 0; } .ss-how li { margin: 6px 0; }
  .bund ul { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 10px; }
  .bund a { display: grid; gap: 2px; padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--surface); text-decoration: none; color: var(--text); font-weight: 400; }
  .bund a:hover { border-color: var(--forest); }
  .bund .muted { font-size: 14px; }
  .list { border-top: 1px solid var(--border); margin-top: 14px; max-width: 820px; }
  details { border-bottom: 1px solid var(--border); }
  summary { cursor: pointer; padding: 16px 0; font-weight: 600; font-size: 17px; }
  details p { margin: 0 0 16px; color: var(--muted); max-width: 66ch; }
  .more { margin-top: 18px; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } .who { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .who { grid-template-columns: 1fr; } .ss-how { grid-template-columns: 1fr; }
    .flt { flex-wrap: nowrap; overflow-x: auto; margin: 12px -20px 0; padding: 2px 20px; scrollbar-width: none; } .flt .chip { flex: none; }
    .cta .btn { flex: 1; padding: 0 10px; }
  }
</style>
<script>
  // ბიუჯეტი (ფასი + მიწოდება ≤ ბიუჯეტი) და თემა ერთად
  const grid = document.getElementById('ss-grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('[data-price]')];
  const fee = Number(document.getElementById('ss-products')!.dataset.fee || 0);
  let budget = 0, cat = '';
  const sync = (attr: 'b' | 'c', val: string) => document.querySelectorAll<HTMLButtonElement>(`[data-${attr}]`).forEach((b) => { const on = b.dataset[attr] === val; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
  const apply = () => {
    let n = 0;
    cards.forEach((c) => {
      const ok = (!budget || Number(c.dataset.price) + fee <= budget) && (!cat || c.dataset.cats!.split(' ').includes(cat));
      c.style.display = ok ? '' : 'none'; if (ok) n++;
    });
    document.getElementById('ss-count')!.textContent = `${n} პოსტერი`;
    document.getElementById('ss-empty')!.hidden = n > 0;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-b]').forEach((b) => b.addEventListener('click', () => { budget = Number(b.dataset.b) || 0; sync('b', b.dataset.b!); apply(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-c]').forEach((b) => b.addEventListener('click', () => { cat = b.dataset.c!; sync('c', cat); apply(); }));
</script>
