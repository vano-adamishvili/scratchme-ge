---
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.astro';
---
<Base title="ყველა პოსტერი" description="ყველა გადასაფხეკი პოსტერი ერთ გვერდზე: მოგზაურობა, ფილმები და სერიალები, წიგნები, ბავშვებისთვის, წყვილებისთვის და გამოწვევები.">
  <div class="container page-head"><span class="eyebrow">კატალოგი</span><h1>ყველა პოსტერი</h1></div>
  <Catalog heading={false} />
</Base>
