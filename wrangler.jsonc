{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scratchme",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /shop და /shop/ ერთი გვერდია: მისამართი ყოველთვის დახრილი ხაზის გარეშე (canonical-ის მსგავსად), /shop/ → 301 /shop
    "html_handling": "drop-trailing-slash"
  },
  "observability": { "enabled": true },
  // Cloudflare-ის პანელში დამატებული ცვლადები deploy-ისას არ წაიშალოს
  "keep_vars": true
}
